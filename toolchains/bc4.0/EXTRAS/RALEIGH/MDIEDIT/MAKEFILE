# Mdiedit makefile for Borland C++ 
# usage: make mdiedit.exe

INCLUDE=$(BCBASE)\include
INCLUDPM=$(OPMBASE)\include
LIB=$(BCBASE)\lib
LIBPM=$(OPMBASE)\lib
!IF "$(DEBUG)" == "ON"
CPPFLAGS=-c -v -V -Od -I$(INCLUDE) -I$(INCLUDE)\sys -I$(INCLUDPM) 
TLFLAGS=-c -m -Toe -v   
!ELSE
CPPFLAGS=-c -V -I$(INCLUDE) -I$(INCLUDE)\sys -I$(INCLUDPM)
TLFLAGS=-c -m -Toe  
!ENDIF

.cpp.obj:
    bcc $(CPPFLAGS) $*.cpp

.rc.res:
    brcc -r -fo$*.res -i$(BCBASE)\include $*.rc

all: mdiedit.exe

mdiedit.exe: mdiedit.obj mdiedit.res mdiedit.def
    tlink $(TLFLAGS) $(LIB)\c02 mdiedit, mdiedit, mdiedit, $(LIB)\c2mti $(LIB)\os2 $(LIBPM)\objectpm, mdiedit.def
    rc mdiedit.res

mdiedit.res: mdiedit.rc mdidlg.dlg mdidlg.h
















