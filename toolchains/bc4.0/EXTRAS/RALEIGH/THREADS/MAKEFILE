# Hello makefile for Borland C++ 
# usage: make hello.exe

INCLUDE=$(BCBASE)\include
INCLUDPM=$(OPMBASE)\include
LIB=$(BCBASE)\lib
LIBPM=$(OPMBASE)\lib
!IF "$(DEBUG)" == "ON"
CPPFLAGS=-c -v -V -Od -I$(INCLUDE) -I$(INCLUDE)\sys -I$(INCLUDPM) 
TLFLAGS=-c -m -Toe -v   
!ELSE
CPPFLAGS=-c -V -I$(INCLUDE) -I$(INCLUDE)\sys -I$(INCLUDPM)
TLFLAGS=-c -m -Toe  
!ENDIF

.cpp.obj:
    bcc $(CPPFLAGS) $*.cpp

.rc.res:
    brcc -r -fo$*.res -i$(BCBASE)\include $*.rc

all: threads.exe

threads.exe: threads.obj threads.res threads.def
    tlink $(TLFLAGS) $(LIB)\c02 threads, threads, threads, $(LIB)\c2mti $(LIB)\os2 $(LIBPM)\objectpm, threads.def;
    rc threads.res

threads.res: threads.rc threads.h

















