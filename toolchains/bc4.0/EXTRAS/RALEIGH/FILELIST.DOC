	graph.hpp			header for the demo program
	graph.prj			.prj file for compiling from the IDE
	graph.rc			resource file for the demo program
	printdlg.cpp		source for the printing dialog box
	printdlg.dlg		.dlg for the printing dialog box
	printdlg.h			defines for the printing dialog box
	printdlg.hpp		header for the printing dialog box
						
