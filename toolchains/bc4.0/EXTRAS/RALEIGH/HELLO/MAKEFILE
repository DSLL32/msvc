# Hello makefile for Borland C++ 
# usage: make hello.exe

INCLUDE=$(BCBASE)\include
INCLUDPM=$(OPMBASE)\include
LIB=$(BCBASE)\lib
LIBPM=$(OPMBASE)\lib
!IF "$(DEBUG)" == "ON"
CPPFLAGS=-c -v -V -Od -I$(INCLUDE) -I$(INCLUDE)\sys -I$(INCLUDPM) 
TLFLAGS=-c -m -Toe -v   
!ELSE
CPPFLAGS=-c -V -I$(INCLUDE) -I$(INCLUDE)\sys -I$(INCLUDPM)
TLFLAGS=-c -m -Toe  
!ENDIF

.cpp.obj:
    bcc $(CPPFLAGS) $*.cpp

.rc.res:
    brcc -r -fo$*.res -i$(BCBASE)\include $*.rc

all: hello.exe

hello.exe: hello.obj hello.res hello.def
    tlink $(TLFLAGS) $(LIB)\c02 hello, hello, hello, $(LIB)\c2mti $(LIB)\os2 $(LIBPM)\objectpm, hello.def;
    rc hello.res

hello.res: hello.rc about.dlg about.h hello.h
















