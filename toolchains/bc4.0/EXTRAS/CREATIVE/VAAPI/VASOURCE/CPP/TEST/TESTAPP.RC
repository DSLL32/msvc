// Version info.
//
#ifndef __DEBUG_
// Non-Debug VERSIONINFO
1 VERSIONINFO LOADONCALL MOVEABLE 
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0
FILEFLAGS VS_FFI_FILEFLAGSMASK
FILEOS VOS__WINDOWS16
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Language type = U.S. English (0x0409) and Character Set = Windows, Multilingual(0x04e4)
        BLOCK "040904E4"                            // Matches VarFileInfo Translation hex value.
        BEGIN
            VALUE "CompanyName", "\000"
            VALUE "FileDescription", "test for Windows\000"
            VALUE "FileVersion", "1.0\000"
				VALUE "InternalName", "test\000"
            VALUE "LegalCopyright", "Copyright © 1993.  All Rights Reserved.\000"
            VALUE "LegalTrademarks", "Windows /231 is a trademark of Microsoft Corporation\000"
            VALUE "OriginalFilename", "test.EXE\000"
            VALUE "ProductName", "test for Windows\000"
            VALUE "ProductVersion", "1.0\000"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x04e4, 0x0409        // U.S. English(0x0409) & Windows Multilingual(0x04e4) 1252
    END

END
#else

// Debug VERSIONINFO
1 VERSIONINFO LOADONCALL MOVEABLE 
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK VS_FF_DEBUG | VS_FF_PRERELEASE | VS_FF_PATCHED | VS_FF_PRIVATEBUILD | VS_FF_SPECIALBUILD
FILEFLAGS VS_FFI_FILEFLAGSMASK
FILEOS VOS__WINDOWS16
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        // Language type = U.S. English (0x0409) and Character Set = Windows, Multilingual(0x04e4)
		  BLOCK "040904E4"                            // Matches VarFileInfo Translation hex value.
        BEGIN
            VALUE "CompanyName", "\000"
            VALUE "FileDescription", "test for Windows\000"
            VALUE "FileVersion", "1.0\000"
            VALUE "InternalName", "test\000"
            VALUE "LegalCopyright", "Copyright © 1993.  All Rights Reserved.\000"
				VALUE "LegalTrademarks", "Windows \231 is a trademark of Microsoft Corporation\000"
				VALUE "OriginalFilename", "test.EXE\000"
            VALUE "ProductName", "test for Windows\000"
            VALUE "ProductVersion", "1.0\000"
            VALUE "SpecialBuild", "Debug Version\000"
            VALUE "PrivateBuild", "Built by \000"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x04e4, 0x0409        // U.S. English(0x0409) & Windows Multilingual(0x04e4) 1252
    END

END
#endif

IDD_TDLG DIALOG 50, 32, 129, 137
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "bordlg"
CAPTION "VA Control"
FONT 8, "MS Sans Serif"
{
 CONTROL "&Single", IDC_TRSINGLE, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 83, 15, 40, 12
 CONTROL "A&ll", IDC_TRALL, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 83, 29, 37, 10
 PUSHBUTTON "&Add", IDC_ADD, 80, 48, 47, 14, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Delete", IDC_DELETE, 80, 66, 47, 14, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Rename", IDC_RENAME, 80, 84, 47, 14, WS_GROUP | WS_TABSTOP
 PUSHBUTTON "&Train Action", IDC_TRACTION, 80, 102, 47, 14, WS_GROUP | WS_TABSTOP
 DEFPUSHBUTTON "&Close", IDC_CLOSE, 80, 120, 47, 14, BS_DEFPUSHBUTTON | WS_GROUP | WS_TABSTOP
 LISTBOX IDC_COMMAND, 7, 17, 64, 112, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_BORDER | WS_VSCROLL | WS_GROUP
 CONTROL "Command:", -1, "BorShade", BSS_GROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 2, 3, 73, 131
 CONTROL "Train Voice:", -1, "BorShade", BSS_GROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 81, 3, 45, 40
}


IDD_ADDRENAME DIALOG 9, 15, 86, 56
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "bordlg"
CAPTION "Add Command"
FONT 8, "MS Sans Serif"
{
 EDITTEXT IDC_EDITCOMMAND, 7, 8, 73, 13
 CONTROL "Button", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 2, 27, 36, 24
 CONTROL "Button", IDCANCEL, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 46, 27, 36, 24
 CONTROL "", -1, "BorShade", BSS_GROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 4, 5, 79, 19
}


IDD_TRVOICE DIALOG 58, 33, 84, 82
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "bordlg"
CAPTION "Voice Training"
FONT 8, "MS Sans Serif"
{
 CONTROL "", -1, "BorShade", BSS_GROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 3, 32, 78, 18
 CONTROL "Command:", -1, "BorShade", BSS_GROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 3, 2, 78, 27
 CONTROL "1", IDC_TR1, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 6, 36, 21, 10
 CONTROL "2", IDC_TR2, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE |  WS_TABSTOP, 31, 36, 21, 10
 CONTROL "3", IDC_TR3, "BorRadio", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE |  WS_TABSTOP, 56, 36, 21, 10
// CONTROL "Button", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 2, 53, 36, 24
// CONTROL "Button", IDCANCEL, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP, 44, 53, 36, 24
	CONTROL "Button", IDOK, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 24, 54, 36, 24
 	CONTROL "Button", IDCANCEL, "BorBtn", BS_DEFPUSHBUTTON | WS_CHILD | NOT WS_VISIBLE|WS_GROUP|WS_TABSTOP, 24, 55, 36, 24

 LTEXT "", IDC_COMMAND, 7, 15, 71, 13
}


IDD_USER DIALOG 6, 15, 99, 121
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "bordlg"
CAPTION "Change User"
FONT 8, "MS Sans Serif"
{
 COMBOBOX IDC_USERLB, 6, 10, 87, 79, CBS_SIMPLE | CBS_SORT | CBS_DISABLENOSCROLL | WS_VSCROLL | WS_TABSTOP
 CONTROL "Button", IDOK, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 11, 92, 36, 24
 CONTROL "Button", IDCANCEL, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 57, 92, 36, 24
}


IDD_CONFIDENCE DIALOG 38, 40, 121, 125
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "bordlg"
CAPTION "Confidence"
FONT 8, "MS Sans Serif"
{
 LTEXT "Command:", IDC_COMMAND, 5, 12, 62, 76
 LTEXT "Score:", IDC_SCORE, 75, 11, 41, 77
 CONTROL "Button", IDOK, "BorBtn", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 42, 96, 36, 24
 CONTROL "", -1, "BorShade", BSS_GROUP | BSS_CAPTION | BSS_LEFT | WS_CHILD | WS_VISIBLE, 1, 8, 117, 85
 CONTROL "", -1, "BorShade", BSS_VDIP | BSS_LEFT | WS_CHILD | WS_VISIBLE, 70, 8, 1, 85
}


