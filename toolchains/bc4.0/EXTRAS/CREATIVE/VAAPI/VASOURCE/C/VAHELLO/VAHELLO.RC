#include <windows.h>
#include <bwcc.h>
VAHELLO DIALOG 32, 20, 99, 16
STYLE WS_OVERLAPPED | WS_POPUP | WS_CAPTION | WS_SYSMENU
CLASS "VAHELLO"
CAPTION "VA HELLO"
BEGIN
	CONTROL "", 101, "BorShade", 1 | WS_CHILD | WS_VISIBLE, -1, -4, 101, 22
	CONTROL "      Please say ""Hello""!", 102, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 3, 2, 93, 11
END




