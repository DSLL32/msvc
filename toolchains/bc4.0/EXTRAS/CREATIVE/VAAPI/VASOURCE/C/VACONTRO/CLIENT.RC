#include <windows.h>
#include <bwcc.h>
#include "apicli.h"

CLIENT DIALOG 13, 18, 220, 155
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CLASS "CLIENT"
CAPTION "API sample for VoiceAssist"
BEGIN
	CONTROL "", IDD_LISTBOX, "LISTBOX", LBS_NOTIFY | LBS_HASSTRINGS | LBS_DISABLENOSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL, 5, 63, 64, 89
	PUSHBUTTON "Init. Link", IDD_INITIATE, 124, 4, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Term. Link", IDD_TERMINATE, 124, 17, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Advise", IDD_ADVISE, 124, 47, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Unadvise", IDD_UNADVISE, 124, 34, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Enable", IDD_ACTIVATE, 77, 64, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "D&isable", IDD_DEACTIVATE, 77, 76, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "U&ser", IDD_CHANGE_USER, 172, 77, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Request", IDD_REQUEST, 124, 126, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Vassist O&n", IDD_OPENDRV, 124, 64, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Vassist O&ff", IDD_CLOSEDRV, 124, 77, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Action On", IDD_ENABLE_ACTION, 124, 94, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Action Off", IDD_DISABLE_ACTION, 124, 108, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Close V.A.", IDD_CLOSE, 171, 108, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Get users", IDD_GETUSERS, 172, 64, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 121, 2, 46, 28
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 121, 32, 46, 28
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 120, 62, 46, 28
	CONTROL "", IDD_APPLICATION, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 4, 17, 64, 11
	CONTROL "", IDD_NO_COMMANDS, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 72, 3, 38, 11
	CONTROL "", IDD_SNDNC_ON_OFF, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 72, 17, 38, 11
	CONTROL "", IDD_MESSAGE, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 4, 31, 64, 11
	CONTROL "", IDD_MESSAGE_DATA, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 72, 31, 38, 11
	CONTROL "", IDD_USER_NAME, "EDIT", ES_LEFT | ES_UPPERCASE | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 4, 3, 64, 11
	CONTROL "", IDD_USERLIST, "LISTBOX", LBS_STANDARD | LBS_HASSTRINGS | WS_CHILD | WS_VISIBLE, 168, 3, 47, 58
	CONTROL "", IDD_ADVISEFLAG, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 4, 46, 64, 11
	CONTROL "", IDD_ACTIONFLAG, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_GROUP, 72, 46, 38, 11
	PUSHBUTTON "&Delete", IDD_DELETE, 77, 102, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Add", IDD_ADD, 77, 90, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Tr. voice", IDD_TR_VOICE, 77, 127, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Tr. action", IDD_TR_ACTION, 77, 139, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Save", IDD_SAVE, 124, 139, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 168, 62, 46, 28
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 168, 92, 47, 29
	PUSHBUTTON "Open V.A.", IDD_OPEN, 171, 94, 39, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 168, 123, 47, 29
	PUSHBUTTON "Capture", 133, 172, 125, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Release", 134, 172, 138, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 75, 62, 43, 90
	CONTROL "", -1, "static", SS_BLACKRECT | WS_CHILD | WS_VISIBLE, 313, 71, 20, 20
	ICON "", -1, 286, 92, 16, 16
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 120, 92, 46, 29
	CONTROL "", -1, "static", SS_BLACKFRAME | WS_CHILD | WS_VISIBLE, 120, 123, 46, 29
	PUSHBUTTON "&Rename", IDD_RENAME, 77, 114, 40, 11, WS_CHILD | WS_VISIBLE | WS_TABSTOP
END



AddCommand DIALOG 19, 50, 97, 54
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Command"
BEGIN
	CONTROL "", ADD_EDIT, "EDIT", ES_LEFT | ES_WANTRETURN | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 8, 13, 81, 14
	PUSHBUTTON "OK", IDOK, 10, 33, 32, 17, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", ADD_CANCEL, 56, 34, 32, 16, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", 102, "BorShade", 1 | WS_CHILD | WS_VISIBLE, -1, 0, 98, 55
	CONTROL "Name:", 104, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 5, 3, 88, 27
END
RenameCommand DIALOG 19, 50, 97, 54
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Rename Command"
BEGIN
	CONTROL "", ADD_EDIT, "EDIT", ES_LEFT | ES_WANTRETURN | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 8, 13, 81, 14
	PUSHBUTTON "OK", IDOK, 10, 33, 32, 17, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "Cancel", ADD_CANCEL, 56, 34, 32, 16, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", 102, "BorShade", 1 | WS_CHILD | WS_VISIBLE, -1, 0, 98, 55
	CONTROL "Name:", 104, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 5, 3, 88, 27
END

TRAINVOICE DIALOG 62, 20, 88, 79
STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Voice Training"
BEGIN
	CONTROL "1", ADD_NOTRAIN, "BorRadio", 9 | WS_CHILD | WS_VISIBLE | WS_GROUP, 5, 43, 17, 10
	CONTROL "2", ADD_NOTRAIN2, "BorRadio", 9 | WS_CHILD | WS_VISIBLE, 33, 43, 17, 10
	CONTROL "3", ADD_NOTRAIN3, "BorRadio", 9 | WS_CHILD | WS_VISIBLE, 63, 43, 17, 10
	EDITTEXT ADD_EDIT, 5, 12, 78, 16, ES_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP
	PUSHBUTTON "OK", IDOK, 25, 59, 36, 18, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", 106, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 0, 0, 90, 80
	CONTROL " Command:", 107, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 2, 1, 84, 29
	CONTROL "Training", 102, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 2, 32, 84, 24
	CONTROL "Cancel", IDCANCEL, "BUTTON", BS_PUSHBUTTON | WS_CHILD | NOT WS_VISIBLE | WS_TABSTOP, 26, 59, 36, 18
END

