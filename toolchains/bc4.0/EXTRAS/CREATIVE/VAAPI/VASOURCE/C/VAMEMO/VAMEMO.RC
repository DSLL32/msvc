#include <windows.h>
#include <bwcc.h>
#include "vamemo.h"

VAMEMO DIALOG 25, 10, 152, 136
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CLASS "VAMEMO"
CAPTION "VoiceAssist Memos"
BEGIN
	PUSHBUTTON "&Add", IDD_ADD, 110, 13, 39, 17, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	PUSHBUTTON "&Delete", IDD_DELETE, 110, 38, 39, 18, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "&Stop", IDD_STOPRECORD, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP, 110, 64, 39, 18
	CONTROL "", IDD_EDIT, "EDIT", ES_LEFT | ES_WANTRETURN | WS_CHILD | WS_TABSTOP | WS_BORDER, 58, 91, 91, 13
	CONTROL "", IDD_STATUS, "static", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_BORDER, 5, 111, 143, 18
	CONTROL "", IDD_LISTBOX, "LISTBOX", LBS_NOTIFY | LBS_HASSTRINGS | LBS_DISABLENOSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_VSCROLL, 6, 11, 97, 73
	CONTROL "                 MEMOS", 104, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 3, 2, 103, 84
	CONTROL "", -1, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 3, 108, 147, 24
	CONTROL "", -1, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 0, 0, 152, 137
	CONTROL "", -1, "static", SS_BLACKRECT | WS_CHILD | WS_VISIBLE, 313, 71, 20, 20
	CONTROL " Memo Name:", 102, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 5, 91, 50, 13
END

AddCommand DIALOG 81, 30, 97, 31
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Add Command"
BEGIN
	CONTROL "", ADD_EDIT, "EDIT", ES_LEFT | ES_WANTRETURN | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 10, 6, 81, 17
	CONTROL "OK", IDOK, "BUTTON", BS_PUSHBUTTON | WS_CHILD | NOT WS_VISIBLE | WS_TABSTOP, 59, 27, 32, 1
	CONTROL "", 102, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 1, 1, 97, 30
END

RecordMemo DIALOG 36, 28, 155, 41
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION
CAPTION "Record Memo"
BEGIN
	PUSHBUTTON "OK", IDOK, 61, 25, 24, 14, WS_CHILD | WS_VISIBLE | WS_TABSTOP
	CONTROL "", 101, "BorShade", 1 | WS_CHILD | WS_VISIBLE, 0, 0, 155, 42
	CONTROL " Please record your memo. 10 seconds max", 102, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 2, 6, 150, 16
END


VAMEMO ACCELERATORS 
BEGIN
	"a", IDD_ADD, ASCII, NOINVERT, ALT
	"A", IDD_ADD, ASCII, NOINVERT, ALT
	"d", IDD_DELETE, ASCII, NOINVERT, ALT
	"D", IDD_DELETE, ASCII, NOINVERT, ALT
	VK_RETURN, IDD_STOPRECORD, VIRTKEY, NOINVERT
	"s", IDD_STOPRECORD, ASCII, NOINVERT, ALT
	"S", IDD_STOPRECORD, ASCII, NOINVERT, ALT
END

