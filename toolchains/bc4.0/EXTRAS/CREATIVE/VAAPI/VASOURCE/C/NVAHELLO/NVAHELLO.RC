#include <windows.h>
#include <bwcc.h>
HELLO DIALOG 52, 24, 99, 16
STYLE DS_MODALFRAME | WS_OVERLAPPED | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CLASS "HELLO"
CAPTION "NVA HELLO"
BEGIN
	CONTROL "", 102, "BorShade", 1 | WS_CHILD | WS_VISIBLE, -1, -4, 101, 22
	CONTROL "      Please say ""Hello""!", 102, "BorShade", BSS_GROUP | WS_CHILD | WS_VISIBLE, 3, 2, 93, 11
END

HELLO ACCELERATORS
BEGIN
	"H",	102,	ALT
   "h",	102,	ALT
END


