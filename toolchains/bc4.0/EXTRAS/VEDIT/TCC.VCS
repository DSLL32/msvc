!FUNC-0!
YT"Borland Turbo C 2"
JM

!FUNC-1!
-@OC"|Ru > VCS.TMP"
JM

!FUNC-2!
1XS(97)
_$N"|{|<Error ,|<Warning ,|<Error:,|<Warning:}"

!F-3-1!
(.rv<>Q97)[
    Q96=2[
	_Z
	][
	_B
	]
    JM
    ]
(.ip>=3)[
    0XS(95) RE(g)
    ]
(.ip<3)[
    .lnXS(97)
    .pXBB N" "
    .ln=Q97[
	    .pXBE .vXS(95)
	    .bb,(.be-1)RC(g)
	    ][
	    0XS(95) RE(g) .bbEJ
	    ]
    ]
$N"|>" -0RC(h)
1L -XBB
JM

!FUNC-3!
(2-.eof)XS(97)
-Q97_$N"|{|<Error ,|<Warning ,|<Error:,|<Warning:}"
(.rv=Q97)[ .nC ]
JP"F-3-1"

!FUNC-4!
!FUNC-5!
RI(v)"*.C"
JM

!FUNC-6!
(Q95-.ln)L				!Goto line # Q95
JM
