	_Z			
	][			
	_B			
	]
    ][				
    (.n=0)[			
	0XS(95) RE(g)		
	]
    (.n=10)[			
	.pXBB			
	.lnXS(97)		
	N"(" (~.er)&(.ln=Q97)[	
	    .pXBE .vXS(95)	
	    .bb,(.be-1)RC(g)	
	    ][
	    0XS(95) RE(g) .bbEJ	
	    ]
	]
    $N"|>" -0RC(h)		
    1L -XBB			
    ]
JM

