    ]
EE(#76) .of[
    (Q80=-1)[ .pXS(80) ]
    :EY
    ]
2XS(96)	EE(s) _B

~.ws(h)[ YWI
    (.wb=2)[ 0YWB(h) 1 ][ YWB(h) 1 ]
    ]
YWS(@) Q87YEA

#[
    0XS(75)
    EE(g) EQY EE(h) EQY
    EE(s) M(y)
    ~.u(h)[
	YWS(@) YWB(e) 1 YWS(e) Q90YEA YEC
	YT"No more errors"
	EE(#76) .of[ :EX ] RE(t)
	][
	.rt(g)[
	    EE(g) B
	    .os<4[ #$S"/"\" B ]
	    RM(t) .rv>0[
		EE(#76) .of[ :EY ]
		YQ |Rg
		.rvXS(77)
		(Q77>0)[
		    EE(#77)
		    ][
		    Q76XS(77)
		    EB |Rg
		    ]
		]
	    ][
	    EE(#76) .of[ :EY ]
	    ]
	RR(g,t)
	EE(h)
	Z -C (.c<>10)[ C ][
	    -C (.c<>13)[ C ]
	    ]
	2D
	.lnXS(94)
	Q94XS(97) B
	Q97[
	    $N"|>"
	    ((.cn+1)/.wc)XA(94)
	    :L
	    ]
	(Q94>8)[ 8XS(94) ]
	YWS(@) YWB(e) Q94
	YWS(e) Q90YEA YEC RT(h)
	EE(v) EQY
	EE(#77) 6XS(96) M(y)
	80[ .cn>=Q75JL 1C ]
	]

!OP-C-4!
    EE(#77) YWS(@) Q87YEA
    .u(h)>0[
	~.u(g)[
	    YWS(@) YEC YT"
    Error not related to a particular source file.

    See error message below or press B to examine error list."
	    ][
	    YWS(h) Q89YEA YEC
	    YT"Edit file; press <Esc> for other options"
	    YWS(@)
	    V
	    ]
	]
    #[
	YWS(h) Q89YEA YEC YT" Select option from status line"
	Q79>0[
+:XK(84)" [N]ext  [P]rev  [F]irst  [B]rowse  [M]ake  [R]etry  [S]kip  E[X]it to Menu "
	    ][
+:XK(84)" [N]ext  [P]revious  [F]irst  [B]rowse  [R]ecompile  E[X]it to Menu "
	    ]
	Q84&95XS(84)
	Q84=27[ JP"OP-C-4" ]
	Q84="N[ 2XS(96) JL ]
	Q84="P[ 3XS(96) JL ]
	Q84="F[ 2XS(96) EE(s) _B JL ]
	Q84="B[
	    YWD(e)
	    YWS(h) Q89YEA YEC
	    YT"Position on desired error and press <Esc> "
	    YWS(@) EE(s) 2XS(96) V 0L JL
	    ]

	((Q84="R) | (Q84="E) | (Q84="X) | (((Q84="M) | (Q84="S)) & (Q79>0)))[
	    EE(#76) .oa[ :EA ]
	    ][
	    YA
	    JP"OP-C-4"
	    ]

	(((Q84="E) | (Q84="X)) & (Q79>0))[
	    0XS(79)
	    0XS(93)
	    ]

	(Q84="R) & (Q79=0)[
	    RE(t)
	    (Q98=18 | Q98=19)[ JP"OPTION-M" ]
	    JP"OPTION-C"
	    ]

	(Q84="M)[
	    0XS(79)
	    0XS(93)
   	    EE(n) EQY EE(s) EQY EE(#76)
	    JP"OPTION-M"
	    ]

	(Q84="S)[
	    1XA(79)
	    ]

	JP"MAIN"
	]

    .ws(e)>0[ YWD(e) ]
    ]

