; ED for Windows Setup.Inf file for ED4W Ver 2.01 ** DEMONSTRATION VERSION **
; Programmer : Neville Franks
; Date       : 18 Aug 93

[Application] 
;Application global information 
AppName=ED - The Advanced Configurable Editor
DefDir=\ED4WDEMO
SpaceNeeded=865
DefPMGroup=ED4WDEMO.GRP, ED for Windows

[PM Info] 
;File Name, Expanded File Name, App Description, Icon file #, Icon #
ED4W.EX_, ED4W.EXE,    ED for Windows *DEMO*

 
[Disks] 
;List of diskettes needed to install the product and the name 
;of each diskette.
1=ED for Windows
 
[Dirs] 
;lists of directories that must be created from the destination directory 
;files to be copied are in the same directory structure on the 
;floppy (by default) 
1=.
2=CONFIG
3=SOURCE

[Options]
;List of installable options.  Desc string must not be more than 25 chars
; (option #), option name, space required
1,&Executable files. . .,646
2,&Help text . . .,163
3,&Keyboard/menu files. . .,178
4,&Extension quick ref. . . ,16
;4,Extension &compiler. . .,164
;5,Extension &API Help. . .,366
;6,Extension &source . . .,818
;7,Ext &Resource Sample. . .,19


