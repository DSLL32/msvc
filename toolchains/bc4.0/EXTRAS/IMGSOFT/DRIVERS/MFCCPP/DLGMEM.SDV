$VAR VOk = "N"$		 	// Check to see if OK or Cancel has been redefined
$VAR VCancel = "N"$
$LOOP Dialog.Buttons$  
	$IF Button.ID == "1"$
	$OR Button.ID == "IDOK"$
	$VOk = "Y"$
	$ELSE$
		$IF Button.ID == "2"$
		$OR Button.ID == "IDCANCEL"$
		$VCancel = "Y"$
		$END IF$
	$END IF$
$END LOOP$
//
// $CAP(Dialog.Name)$ message map:
// Associate messages with appropriate member functions.
//
$IF Dialog.IsModal == "N"$
BEGIN_MESSAGE_MAP( $CAP(Dialog.Name)$, CDialog )
	ON_WM_DESTROY()	 //Make sure destructor is called
	$IF VCancel == "N"$
	ON_COMMAND(IDCANCEL, OnCancel )
	$END IF$
$ELSE$
BEGIN_MESSAGE_MAP( $CAP(Dialog.Name)$, CModalDialog )
$END IF$
	$IF VOk == "N"$
	ON_COMMAND(IDOK, OnOK )
	$END IF$
	$LOOP Menu.MenuStrings$  
	ON_COMMAND(IDM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, On$TRIM(MenuItem.PopupName+MenuItem.Name)$ )
	$END LOOP$
	$LOOP Dialog.Buttons$  
	ON_BN_CLICKED($Button.Id$, OnBtn$Button.Name$ )
	$END LOOP$
	$LOOP ToolBar.ToolItems WHERE ToolItem.ToolType == "Button"$  
	ON_COMMAND( IDT_$UP(ToolBar.Name+ToolItem.Name)$, On$ToolBar.Name+ToolItem.Name$ )
	$END LOOP$
	//$PROTECTBLOCK	"d"+CAP(Dialog.Name)+"MsgMap"$
END_MESSAGE_MAP()
//
// Dialog Member Functions - $CAP(Dialog.Name)$ 
//
$CAP(Dialog.Name)$::$CAP(Dialog.Name)$(CWnd* pParentWnd) 
$IF Dialog.IsModal == "N"$
	: CDialog()
$ELSE$
	: CModalDialog( "$Dialog.Name$", pParentWnd )
$END IF$
{
$IF Dialog.IsModal == "N"$
	if (!Create("$Dialog.Name$", pParentWnd))
		 AfxAbort();
$END IF$
$IF COUNT(Menu.MenuStrings WHERE MenuItem.AccelKey != "") > 0$
	LoadAccelTable("$Dialog.Name$");	 
$END IF$
	//$PROTECTBLOCK	"d"+CAP(Dialog.Name)+"Constructor"$
}
// Dialog Destructor
$CAP(Dialog.Name)$::~$CAP(Dialog.Name)$() 
{
$IF ToolBar.Name != ""$
	delete pToolbar;	// Delete tool bar object
$END IF$
	//$PROTECTBLOCK	"d"+CAP(Dialog.Name)+"Destructor"$
}
// 
//OnInitDialog - Initialize dialog controls and data
//
BOOL $CAP(Dialog.Name)$::OnInitDialog()
{
	// Call base class for proper initialization.
	if (!CDialog::OnInitDialog())
		return FALSE;

$IF ToolBar.Name != ""$	 // Don't create until we have a window handle
	// Create ToolBar
	pToolbar = new TToolBar(this, $ToolBar.H$);	
	$LOOP ToolBar.ToolItems$
	pToolbar->Add("$ToolItem.ToolType$", IDT_$UP(ToolBar.Name)UP(ToolItem.Name)$, $ToolItem.X$, $ToolItem.Y$, $ToolItem.W$, $ToolItem.H$, 
		 "N$ToolBar.Name+ToolItem.Name$", "S$ToolBar.Name+ToolItem.Name$", "$ToolItem.DrawShadow$", "$ToolItem.DrawBorder$");
	$END LOOP$
$END IF$
$IF Dialog.Caption != ""$
	SetWindowText("$Dialog.Caption$");
$END IF$
$LOOP Dialog.edits WHERE Edit.Length > 0$
	SendDlgItemMessage($Edit.Id$, EM_LIMITTEXT, $Edit.Length$, 0);
$END LOOP$
$LOOP Dialog.RadioButtons WHERE RadioButton.IsInitialCheck == "Y"$
	CheckDlgButton($RadioButton.Id$, TRUE);	 // Set Initial Check
$END LOOP$
$LOOP Dialog.CheckBoxes WHERE CheckBox.IsInitialCheck == "Y"$
	CheckDlgButton($CheckBox.Id$, TRUE);	 // Set Initial Check
$END LOOP$
$LOOP Dialog.ComboBoxs WHERE ComboBox.InitialData != ""$
$ARRAY AInitialData$
$FILLARRAY AInitialData ComboBox.InitialData$
	// Fill Combo with initial values
	CComboBox *$ComboBox.Name$ = (CComboBox *) GetDlgItem($ComboBox.Id$);
	$LOOP AInitialData$
	$ComboBox.name$->AddString("$AInitialData.Value$");
	$END LOOP$
$END LOOP$
$LOOP Dialog.ListBoxs WHERE ListBox.InitialData != ""$
$ARRAY AInitialData$
$FILLARRAY AInitialData ListBox.InitialData$
	// Fill List Box with initial values
	CListBox *$ListBox.Name$ = (CListBox *) GetDlgItem($ListBox.Id$);
	$LOOP AInitialData$
	$ListBox.name$->AddString("$AInitialData.Value$");
	$END LOOP$
$END LOOP$

	//$PROTECTBLOCK	"d"+CAP(Dialog.Name)+"OnInitDialog"$
	return TRUE;
}
//
// Dialog Response functions - $CAP(Dialog.Name)$
//
$LOOP ToolBar.ToolItems WHERE ToolItem.ToolType == "Button"$
void $CAP(Dialog.Name)$::On$ToolBar.Name+ToolItem.Name$()
{
	$VAR VLinkToName = ToolItem.LinkToName$		// setup vars for linkto code 
	$VAR VLinkToType = ToolItem.LinkToType$
	$VAR VItemName = ToolItem.Name$
	$VAR VProtectTag = "d"+CAP(Dialog.Name)+ToolBar.Name+ToolItem.Name$
	$INPUT "linkto.sdv"$	// insert linkto code
}
$END LOOP$
$LOOP Dialog.buttons$  
void $CAP(Dialog.Name)$::OnBtn$Button.name$()
{
	$VAR VLinkToName = Button.LinkToName$		// setup vars for linkto code 
	$VAR VLinkToType = Button.LinkToType$
	$VAR VItemName = Button.Name$
	$VAR VProtectTag = "d"+CAP(Dialog.Name)+Button.Name$
	$INPUT "linkto.sdv"$	//insert linkto code 
}
$END LOOP$
$LOOP Menu.MenuStrings$  
void $CAP(Dialog.Name)$::On$TRIM(MenuItem.PopupName+MenuItem.Name)$()
{
	$VAR VLinkToName = MenuItem.LinkToName$		// setup vars for linkto code 
	$VAR VLinkToType = MenuItem.LinkToType$
	$VAR VItemName = TRIM(MenuItem.PopupName+MenuItem.Name)$
	$VAR VProtectTag = "d"+CAP(Dialog.Name)+VItemName$
	$INPUT "linkto.sdv"$	//insert linkto code
}
$END LOOP$
//
// CanClose - Determine if dialog should be allowed to update
//
BOOL $CAP(Dialog.Name)$::CanClose()
{
$LOOP Dialog.Edits$
$IF Edit.Validation == "Mandatory"$
	if ( GetDlgItemText($Edit.Id$, szWorkStr, sizeof(szWorkStr)) == 0 )
	{
		MessageBox("Mandatory field requires input.", "Error"); 
		::SetFocus(::GetDlgItem(m_hWnd, $Edit.Id$));	 // Position cursor to error
		return FALSE;
	}
$ELSE$
	$IF Edit.Validation == "Integer"$
	GetDlgItemText($Edit.Id$, szWorkStr, sizeof(szWorkStr));
	for (p=szWorkStr; *p; p++ )
	{
		if ( !isdigit(*p) && *p!='-' )
		{
			MessageBox("Invalid integer input.", "Error");
			::SetFocus(::GetDlgItem(m_hWnd, $Edit.Id$));	 // Position cursor to error
			return FALSE;
		}
	}
	$ELSE$
		$IF Edit.Validation == "Float"$
	GetDlgItemText($Edit.Id$, szWorkStr, sizeof(szWorkStr));
	for (p=szWorkStr; *p; p++ )
	{
		if ( !isdigit(*p) && *p!='-' && *p!='.'  )
		{
			MessageBox("Invalid real number input.", "Error"); 
			::SetFocus(::GetDlgItem(m_hWnd, $Edit.Id$)); // Position cursor to error
			return FALSE;
		}
	}
		$END IF$
	$END IF$
$END IF$
$END LOOP$
	//$PROTECTBLOCK	"d"+CAP(Dialog.Name)+"CanClose"$
	return TRUE;
}
$IF VOk == "N"$ // Make sure this hasn't been overrided
//
// OnOK:
// If CanClose() then update data from dialog
//
void $CAP(Dialog.Name)$::OnOK()
{
	if ( !CanClose() ) // Only Update Dialog if CanClose is TRUE
		return;
	
	$IF Dialog.IsModal != "N"$
	CModalDialog::OnOK();
	$ELSE$
	DestroyWindow();	// End Modeless Dialog
	$END IF$
	//$PROTECTBLOCK	"d"+CAP(Dialog.Name)+"OnOK"$
}
$END IF$
