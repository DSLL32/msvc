$OUTPUT VPgmName+".h"$		// Must specify an output file
$VAR VToolItemNum = 500$
$LOOP Application.Windows$
	$LOOP ToolBar.ToolItems$
#define		IDT_$UP(ToolBar.Name)UP(ToolItem.Name))$ $POS(30)VToolItemNum$
$VToolItemNum = VToolItemNum + 1$
	$END LOOP$
$END LOOP$
$LOOP Application.Dialogs$
	$LOOP ToolBar.ToolItems$
#define		IDT_$UP(ToolBar.Name)UP(ToolItem.Name))$ $POS(30)VToolItemNum$
$VToolItemNum = VToolItemNum + 1$
	$END LOOP$
$END LOOP$
$VAR VMenuItemNum = 1000$
$IF Application.Type == "MDI"$
#define		IDM_MDICASCADE $POS(30)$1000
#define		IDM_MDITILE $POS(30)$1001
#define		IDM_MDIICONARRANGE	$POS(30)$1002
#define		IDM_CREATECHILD $POS(30)$1003
#define		IDM_CLOSECHILDREN $POS(30)$1004
$VMenuItemNum = 1005$
$END IF$
$LOOP application.dialogs$
	$LOOP Menu.MenuStrings$
#define		IDM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$ $POS(30)VMenuItemNum$
$VMenuItemNum = VMenuItemNum + 1$
	$END LOOP$
$END LOOP$
$LOOP Application.Windows$
	$LOOP Menu.MenuStrings$
#define		IDM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$ $POS(30)VMenuItemNum$
$VMenuItemNum = VMenuItemNum + 1$
	$END LOOP$
$END LOOP$

$ARRAY AConstants$
$LOOP application.dialogs$
	$LOOP dialog.Controls$
		$ADDVAL AConstants Control.Id$
	$END LOOP$
$END LOOP$
$VAR VCtlNum = 100$
$LOOP AConstants WHERE AConstants.Value < 1$ // Only #Define Text ID's
$IF AConstants.Value != "IDOK"$
$AND AConstants.Value != "IDCANCEL"$
#define		$AConstants.Value$ $POS(30)VCtlNum$
$VCtlNum = VCtlNum + 1$
$END IF$
$END LOOP$
//$PROTECTBLOCK	"AdditionalIDs"$
