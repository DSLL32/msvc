$SETDELIMITER "~"$  // Make uses dollar sign so change delimiter...change back later!!!
~OUTPUT VPgmName+".mak"~		// Must specify an output file
# 
# ~VPgmName~
# Microsoft Make File
DEBUG=1
MODEL = M
CPPFLAGS= /A$(MODEL) /W3 /Zp /GA /GEs /G2
LFLAGS=/NOD /ONERROR:NOEXE

!if "$(DEBUG)"=="1"
CPPFLAGS=/D_DEBUG $(CPPFLAGS) /Od /f /Zi
LFLAGS=$(LFLAGS) /COD
LIBS=$(MODEL)afxcwd libw $(MODEL)libcew mmsystem commdlg
!else
CPPFLAGS=$(CPPFLAGS) /Oselg /Gs
LFLAGS=$(LFLAGS)
LIBS=$(MODEL)afxcw libw $(MODEL)libcew mmsystem commdlg
!endif


PGM=~VPgmName~
OBJS = $(PGM).obj	\
~LOOP AModules~
				~AModules.Value~.obj \
~END LOOP~

.SUFFIXES: .rc

.rc.res:
    rc -r $*.rc

$(PGM).Exe: $(OBJS) $(PGM).def $(PGM).res
     link $(LFLAGS) @<<$(PGM).lnk
$(OBJS)
$(PGM), $(PGM), $(LIBS), $(PGM)
<<
     rc /k $(PGM).res

$(PGM).obj:			$*.cpp $(PGM).hpp
~LOOP AModules~
~AModules.Value~.obj: $*.cpp $*.hpp	
~END LOOP~

$(PGM).res:   $*.rc $*.h

~OUTPUT VPgmName+".def"~		// Must specify an output file
DESCRIPTION '~Application.Desc~'
EXETYPE	WINDOWS
CODE PRELOAD MOVEABLE DISCARDABLE
DATA PRELOAD MOVEABLE MULTIPLE
HEAPSIZE 		8192
STACKSIZE   8192
~SETDELIMITER "$"~  // Restore default delimiter
