$OUTPUT VPgmName+".rc"$		// Must specify an output file
#include <windows.h>
#include "$VPgmName$.h"
$ARRAY ADialogFiles$	// Array to list all dialog resource files
$LOOP Application.Dialogs$
$ADDVAL ADialogFiles Dialog.ResourceFile$
$END LOOP$
$IF COUNT(ADialogFiles) > 0$
// Dialog Resource Files
	$LOOP ADialogFiles$
rcinclude $ADialogFiles.Value$
	$END LOOP$

$END IF$
//$PROTECTBLOCK	"RCIncludes"$
$LOOP Application.Windows WHERE Window.IconFile != ""$
$Window.Name$ ICON $Window.IconFile$
$END LOOP$
$LOOP Application.Dialogs WHERE Dialog.IconFile != ""$
$Dialog.Name$ ICON $Dialog.IconFile$
$END LOOP$

$LOOP Application.Windows WHERE ToolBar.Name != ""$
	$LOOP ToolBar.ToolItems$
	$IF ToolItem.NormBitmapFile != ""$
N$ToolBar.Name+ToolItem.Name$ BITMAP $ToolItem.NormBitmapFile$
	$END IF$
	$IF ToolItem.SelBitmapFile != ""$
S$ToolBar.Name+ToolItem.Name$ BITMAP $ToolItem.SelBitmapFile$
	$END IF$
	$END LOOP$

$END LOOP$
$LOOP Application.Dialogs WHERE ToolBar.Name != ""$
	$LOOP ToolBar.ToolItems$
	$IF ToolItem.NormBitmapFile != ""$
N$ToolBar.Name+ToolItem.Name$ BITMAP $ToolItem.NormBitmapFile$
	$END IF$
	$IF ToolItem.SelBitmapFile != ""$
S$ToolBar.Name+ToolItem.Name$ BITMAP $ToolItem.SelBitmapFile$
	$END IF$
	$END LOOP$

$END LOOP$
$VAR VHasAccels = "N"$	//Flag to indicate accelerators, also used in app.sdv
$VAR VNumPopups = 1$
$LOOP application.Windows WHERE Menu.Name != ""$
$Menu.Name$ MENU
{
	$LOOP Menu.MenuItems$
	$IF MenuItem.MenuItemType == "POPUP"$
	$INPUT "popup.sdv"$
	$ELSE$
		$IF MenuItem.MenuItemType == "SEPARATOR"$
	MENUITEM SEPARATOR
		$ELSE$
			$IF MenuItem.InitialState == "Grayed"$
			$VAR VState = ", GRAYED"$
			$ELSE$
				$IF MenuItem.InitialState == "Checked"$
				$VAR VState = ", CHECKED"$
				$ELSE$
				$VAR VState = ""$
				$END IF$
			$END IF$
			$IF MenuItem.AccelKey != ""$
			$VHasAccels = "Y"$	// Global Flag to indicate accelerators
			$END IF$
			$IF MenuItem.AccelText != ""$
	MENUITEM "$MenuItem.Name$\t$MenuItem.AccelText$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name)) VState$
			$ELSE$
	MENUITEM "$MenuItem.Name$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name)) VState$
			$END IF$
		$END IF$
	$END IF$
	$END LOOP$
	$IF Application.Type == "MDI"$		// If MDI Window default Menu
	$AND Window.IsMain == "Y"$			// Constants are defined in owlrc.h
	POPUP "&Window"									
	{
		MenuItem  "C&reate", CM_CREATECHILD
		MenuItem  "&Cascade", CM_CASCADECHILDREN
		MenuItem  "&Tile", CM_TILECHILDREN
		MenuItem  "Arrange &Icons", CM_ARRANGEICONS
		MenuItem  "C&lose All", CM_CLOSECHILDREN
	}
	$END IF$
}
$END LOOP$

$VNumPopups = 1$
$LOOP application.dialogs WHERE COUNT(Menu.MenuItems) > 0$
$Menu.Name$ MENU		// Menu Name must match MENU in dialog resource
{
	$LOOP Menu.MenuItems$
	$IF MenuItem.MenuItemType == "POPUP"$
	$INPUT "popup.sdv"$
	$ELSE$
		$IF MenuItem.MenuItemType == "SEPARATOR"$
	MENUITEM SEPARATOR
		$ELSE$
			$IF MenuItem.InitialState == "Grayed"$
			$VAR VState = ", GRAYED"$
			$ELSE$
				$IF MenuItem.InitialState == "Checked"$
				$VAR VState = ", CHECKED"$
				$ELSE$
				$VAR VState = ""$
				$END IF$
			$END IF$
			$IF MenuItem.AccelKey != ""$
			$VHasAccels = "Y"$	// Global Flag to indicate accelerators
			$END IF$
			$IF MenuItem.AccelText != ""$
	MENUITEM "$MenuItem.Name$\t$MenuItem.AccelText$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name)) VState$
			$ELSE$
	MENUITEM "$MenuItem.Name$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name)) VState$
			$END IF$
		$END IF$
	$END IF$
	$END LOOP$
}
$END LOOP$

$IF VHasAccels == "Y"$	// Global Flag to indicate accelerators
// Single table to hold all application accelerators
$Application.Name$ ACCELERATORS
{
$LOOP application.Windows WHERE Menu.Name != ""$
	$IF COUNT(Menu.MenuStrings WHERE MenuItem.AccelKey != "") > 0$
	$LOOP Menu.MenuStrings WHERE MenuItem.AccelKey != ""$
		$IF MenuItem.IsAccelVirtual == "Y"$
			$IF MenuItem.AccelType != ""$	   
	VK_$MenuItem.AccelKey$, CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY, $MenuItem.AccelType$
			$ELSE$
	VK_$MenuItem.AccelKey$, CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY
			$END IF$
		$ELSE$
			$IF MenuItem.AccelType != ""$
	"$MenuItem.AccelKey$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY, $MenuItem.AccelType$
			$ELSE$
	"$MenuItem.AccelKey$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY
			$END IF$
		$END IF$
	$END LOOP$
	$END IF$
$END LOOP$
$LOOP application.Dialogs WHERE COUNT(Menu.MenuItems) > 0$
	$IF COUNT(Menu.MenuStrings WHERE MenuItem.AccelKey != "") > 0$
	$LOOP Menu.MenuStrings WHERE MenuItem.AccelKey != ""$
		$IF MenuItem.IsAccelVirtual == "Y"$
			$IF MenuItem.AccelType != ""$	   
	VK_$MenuItem.AccelKey$, CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY, $MenuItem.AccelType$
			$ELSE$
	VK_$MenuItem.AccelKey$, CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY
			$END IF$
		$ELSE$
			$IF MenuItem.AccelType != ""$
	"$MenuItem.AccelKey$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY, $MenuItem.AccelType$
			$ELSE$
	"$MenuItem.AccelKey$", CM_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$, VIRTKEY
			$END IF$
		$END IF$
	$END LOOP$
	$END IF$
$END LOOP$
}
$END IF$	 // Has Accels
