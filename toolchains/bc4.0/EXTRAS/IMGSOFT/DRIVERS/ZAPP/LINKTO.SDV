$IF VLinkToType == "Dialog"$
	$LOOP Application.Dialogs WHERE Dialog.Name == VLinkToName$
		$IF Dialog.IsModal == "N"$
			$CAP(Dialog.Name)$* p=new $CAP(Dialog.Name)$(this, zResId("$Dialog.Name$"));
			p->show();
		$ELSE$
			$CAP(Dialog.Name)$* p=new $CAP(Dialog.Name)$(this, zResId("$Dialog.Name$"));
			p->show();
			p->modal();
			delete p;		 // Modal Dialogs don't delete themselves
		$END IF$
			//$PROTECTBLOCK	VProtectTag$
	$BREAK$
	$END LOOP$
$ELSE$
	$IF VLinkToType == "Window"$
	$LOOP Application.Windows WHERE Window.Name == VLinkToName$
			$VLinkToName$* p=new $VLinkToName$(this, zString("$Window.Caption$"));
			p->show();
		$BREAK$
	$END LOOP$
			//$PROTECTBLOCK	VProtectTag$
	$ELSE$
		$IF VLinkToType == "Application"$
			//$PROTECTBLOCK	VProtectTag$
			WinExec("$LITERAL(VLinkToName)$", SW_SHOW);
		$ELSE$
			$IF VLinkToType == "UserCode"$
			$COPYSOURCE VLinkToName$	 // Insert User Code
			//$PROTECTBLOCK	VProtectTag$
			$ELSE$
				$IF VLinkToType == "CommonDialog"$
				$INPUT "commdlg.sdv"$
				$ELSE$
					$IF VLinkToType == "SoundFile"$
			sndPlaySound("$LITERAL(VLinkToName)$", SND_SYNC);
			//$PROTECTBLOCK	VProtectTag$
					$ELSE$
			//$PROTECTBLOCK	VProtectTag$
					$END IF$
				$END IF$
			$END IF$
		$END IF$
	$END IF$
$END IF$
