//
// Dialog Member Functions - $CAP(Dialog.Name)$ 
//
$CAP(Dialog.Name)$::$CAP(Dialog.Name)$(pWindow Parent) 
$IF Dialog.IsModal == "N"$
$OR Dialog.IsMain == "Y"$
: ModeLessDialog (Parent, ResID($Dialog.Name$))
$ELSE$
: DialogWindow (Parent, ResID($Dialog.Name$))
$END IF$
$IF Menu.Name != ""$
 ,$Menu.Name$Menu(ResID($Menu.Name$))	
$END IF$
$IF COUNT(Menu.MenuStrings WHERE MenuItem.AccelKey != "") > 0$
 ,$Menu.Name$Accel(ResID(IDA_$UP(Menu.Name)$))
$END IF$
{
	$IF Menu.Name != ""$
	ChangeMenu(&$Menu.Name$Menu);
		$IF COUNT(Menu.MenuStrings WHERE MenuItem.AccelKey != "") > 0$
	ChangeAccel(&$Menu.Name$Accel);
		$END IF$
	$END IF$
	$IF Dialog.Caption != ""$
	SetCaption("$Dialog.Caption$");
	$END IF$
	$LOOP Dialog.listboxs$
	$listbox.name$ = new ListBox(this, $listbox.Id$);
	$END LOOP$
	$LOOP Dialog.edits$
	$edit.name$ = new SingleLineEdit(this, $edit.Id$);
		$IF Edit.Length > 0$
	$edit.name$->SetTextLimit($Edit.Length$);
		$END IF$
	$END LOOP$
	$LOOP Dialog.statics$
	$static.name$ = new FixedText(this, $Static.Id$);
	$END LOOP$
	$LOOP Dialog.CheckBoxs$
	$CheckBox.name$ = new CheckBox(this, $CheckBox.Id$);
	$END LOOP$
	$LOOP Dialog.ComboBoxs$
	$ComboBox.name$ = new ComboBox(this, $ComboBox.Id$);
	$END LOOP$
	$LOOP Dialog.RadioButtons$
	$RadioButton.name$ = new RadioButton(this, $RadioButton.Id$);
	$END LOOP$

$IF ToolBar.Name != ""$
 	pTB = new ToolBar(this, ResID(IDD_TOOLBAR), $ToolBar.H$);	
	$LOOP ToolBar.ToolItems$
	pTB->AddTool("$ToolItem.ToolType$", IDTI_$UP(ToolBar.Name)UP(ToolItem.Name)$, Point($ToolItem.X$, $ToolBar.H$-($ToolItem.Y$)), 
		Dimension($ToolItem.W$, $ToolItem.H$), ResID(IDNB_$UP(ToolBar.Name+ToolItem.Name)$), 
		ResID(IDSB_$UP(ToolBar.Name+ToolItem.Name)$), "$ToolItem.DrawShadow$", "$ToolItem.DrawBorder$");
	$END LOOP$
	pTB->Show();
$END IF$
$LOOP Dialog.RadioButtons WHERE RadioButton.IsInitialCheck == "Y"$
	$RadioButton.Name$->SetState(TRUE);	 // Set Initial Check
$END LOOP$
$LOOP Dialog.CheckBoxes WHERE CheckBox.IsInitialCheck == "Y"$
	$CheckBox.Name$->SetState(TRUE);	 // Set Initial Check
$END LOOP$
$LOOP Dialog.ComboBoxs WHERE ComboBox.InitialData != ""$
$ARRAY AInitialData$
$FILLARRAY AInitialData ComboBox.InitialData$
	// Fill Combo with initial values
	$LOOP AInitialData$
	$ComboBox.name$->AddString("$AInitialData.Value$");
	$END LOOP$
$END LOOP$
$LOOP Dialog.ListBoxs WHERE ListBox.InitialData != ""$
$ARRAY AInitialData$
$FILLARRAY AInitialData ListBox.InitialData$
	// Fill List Box with initial values
	$LOOP AInitialData$
	$ListBox.name$->AddString("$AInitialData.Value$");
	$END LOOP$
$END LOOP$
	//$PROTECTBLOCK	"d"+Dialog.Name+"Constructor"$
}
// 
// Dialog Destructor
//
$CAP(Dialog.Name)$::~$CAP(Dialog.Name)$() 
{
$IF ToolBar.Name != ""$
	if (pTB)
		delete pTB;
$END IF$
}
//
// Distribute and handle Button click events 
//
void $CAP(Dialog.Name)$::ButtonClick( ControlEvt e )
{
	switch (uint(e.GetControlID()))
	{
		$VAR VOk = "N"$		 	// Check to see if OK or Cancel has been redefined
		$VAR VCancel = "N"$
		$LOOP Dialog.Buttons$
			$IF Button.ID == "1"$
			$OR Button.ID == "IDOK"$
			$VOk = "Y"$
			$ELSE$
				$IF Button.ID == "2"$
				$OR Button.ID == "IDCANCEL"$
				$VCancel = "Y"$
				$END IF$
			$END IF$
		case $Button.ID$:
		{
			$VAR VLinkToName = Button.LinkToName$		// setup vars for linkto code 
			$VAR VLinkToType = Button.LinkToType$
			$VAR VItemName = Button.Name$
			$INPUT "linkto.sdv"$	//insert linkto code
			//$PROTECTBLOCK	"d"+Dialog.Name+"Button"+Button.ID$
		}
		break;  
		$END LOOP$	// Buttons
		// $PROTECTBLOCK "d"+Dialog.Name+"ButtonClick"$
		$IF VOk != "Y"$
		case IDOK:
			if (CanClose())
			{
				//$PROTECTBLOCK	"d"+Dialog.Name+"ButtonOK"$
				EndDlg(TRUE);
			}
			break;
		$END IF$
		$IF VCancel != "Y"$
		case IDCANCEL:
			//$PROTECTBLOCK	"d"+Dialog.Name+"ButtonCancel"$
			EndDlg(FALSE);
			break;
		$END IF$
		default:
			return;
	}
}
//
// Tool Item selections are treated like a menu command 
//
void $CAP(Dialog.Name)$::MenuCommand( MenuCommandEvt e ) 
{
	switch (e.GetItemID())
	{
		$LOOP Menu.MenuStrings$  
		case IDMI_$UP(TRIM(MenuItem.PopupName+MenuItem.Name))$:
		{
			$VAR VLinkToName = MenuItem.LinkToName$		// setup vars for linkto code 
			$VAR VLinkToType = MenuItem.LinkToType$
			$VAR VItemName = TRIM(MenuItem.PopupName+MenuItem.Name)$
			$INPUT "linkto.sdv"$	//insert linkto code
			// $PROTECTBLOCK "w"+Dialog.Name+"Menu"+VItemName$
		}
		break;  
		$END LOOP$  //MenuStrings
		$LOOP ToolBar.ToolItems WHERE ToolItem.ToolType == "Button"$
		case IDTI_$UP(ToolBar.Name)UP(ToolItem.Name)$:
		{
			$VAR VLinkToName = ToolItem.LinkToName$		// setup vars for linkto code 
			$VAR VLinkToType = ToolItem.LinkToType$
			$VAR VItemName = ToolItem.Name$
			$INPUT "linkto.sdv"$	//insert linkto code
			//$PROTECTBLOCK	"d"+Dialog.Name+"Tool"+ToolBar.Name+ToolItem.Name$
		}
		break;  
		$END LOOP$	// ToolItems
		// $PROTECTBLOCK "d"+Dialog.Name+"MenuCommand"$
		default:
			Window::MenuCommand(e);	 // Pass msg on
	}
}
//
// CanClose - Determine if dialog should be allowed to update
//
Bool $CAP(Dialog.Name)$::CanClose()
{
$LOOP Dialog.Edits$
$IF Edit.Validation == "Mandatory"$
	if ( $Edit.Name$->GetTextLen() == 0 )
	{
		MessBox *Msg = new MessBox("Info", "Mandatory field requires input", this); 
		Msg->Show();
		delete Msg;
		$Edit.Name$->SetFocus();	 // Position cursor to error
		return FALSE;
	}
$ELSE$
	$IF Edit.Validation == "Integer"$

	$Edit.Name$->GetText(szWorkStr, 80);
	for (p=szWorkStr; *p; p++ )
	{
		if ( !(*p>='0' && *p<='9') && *p!='-' )
		{
			MessBox *Msg = new MessBox("Info", "Invalid integer input", this); 
			Msg->Show();
			delete Msg;
			$Edit.Name$->SetFocus();	 // Position cursor to error
			return FALSE;
		}
	}
	$ELSE$
		$IF Edit.Validation == "Float"$
	$Edit.Name$->GetText(szWorkStr, 80);
	for (p=szWorkStr; *p; p++ )
	{
		if ( !(*p>='0' && *p<='9') && *p!='-' && *p!='.' )
		{
			MessBox *Msg = new MessBox("Info", "Invalid real input", this); 
			Msg->Show();
			delete Msg;
			$Edit.Name$->SetFocus();	 // Position cursor to error
			return FALSE;
		}
	}
		$END IF$
	$END IF$
$END IF$
$END LOOP$
	//$PROTECTBLOCK	"d"+Dialog.Name+"CanClose"$
	return TRUE;
}
