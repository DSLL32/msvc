#
# Tutor
#	Borland Make File
.swap
.autodepend
CC=bcc
LINK=tlink
LFLAGS= /Tw /v /n /c
LIBDIR=\BORLANDC\LIB
INCLUDE=\BORLANDC\INCLUDE
MODEL=m
LIBS=cw$(MODEL) c$(MODEL) import

PGM=Tutor
OBJS = $(PGM).obj	\
				jtools.obj \

$(PGM).exe: turboc.cfg $(OBJS) $(PGM).res
     $(LINK) $(LFLAGS) @&&!
	  $(LIBDIR)\c0w$(MODEL) $(OBJS)
	  $(PGM)
	  nul
	  $(LIBS)
	  $(PGM).def
!
     rc -K $(PGM).res $(PGM).exe

turboc.cfg: $(PGM).bor
	echo -I$(INCLUDE) -DSTRICT -L$(LIBDIR)>turboc.cfg

$(PGM).res: $(PGM).rc 
     rc -r -I$(INCLUDE) $(PGM).rc

.cpp.obj :
    $(CC) -c -m$(MODEL) -v -W -w-par $<

.c.obj :
    $(CC) -c -m$(MODEL) -v -W -w-par $<


clean:
	del *.obj
	del *.exe
	del *.res
	del *.map
	del *.sym

