		MenuItem "&New\tCtrl+N", CM_NEW
		MenuItem "&Open...", CM_OPEN
		MenuItem "&Save...", CM_SAVE
		MenuItem "&Print...", CM_PRINT
		MenuItem SEPARATOR
		MenuItem "&Exit", CM_EXIT
	}
	POPUP "&Help"
	{
		MenuItem "&About...", CM_ABOUT
	}
}


