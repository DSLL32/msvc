	CONTROL "Company", -1, "static", SS_LEFT | WS_CHILD, 2, 62, 41, 8
	CONTROL "", ID_CONAME, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_CHILD | WS_VISIBLE | WS_BORDER | WS_TABSTOP, 67, 59, 124, 12
	CONTROL "Address", -1, "static", SS_LEFT | WS_CHILD, 2, 78, 32, 8
	CONTROL "", ID_STREET1, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 67, 74, 124, 12
	CONTROL "", ID_STREET2, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 67, 89, 124, 12
	CONTROL "City, State, Zip", -1, "static", SS_LEFT | WS_CHILD, 2, 110, 57, 8
	CONTROL "", ID_CITY, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 67, 104, 95, 12
	CONTROL "", ID_STATE, "edit", ES_LEFT | ES_AUTOHSCROLL | ES_UPPERCASE | WS_BORDER | WS_TABSTOP | WS_CHILD, 164, 104, 18, 12
	CONTROL "", ID_ZIP, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 186, 104, 37, 12
	CONTROL "", ID_BPHONE, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 67, 128, 57, 12
	CONTROL "", ID_HPHONE, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 130, 128, 57, 12
	CONTROL "", ID_FAX, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 191, 128, 57, 12
	CONTROL "", ID_COMMENTS, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 67, 145, 182, 12
	CONTROL "Business", -1, "static", SS_CENTER | WS_CHILD, 70, 120, 55, 8
	CONTROL "Fax", -1, "static", SS_CENTER | WS_CHILD, 194, 120, 55, 8
	CONTROL "Home", -1, "static", SS_CENTER | WS_CHILD, 131, 120, 55, 8
	CONTROL "Phone:", -1, "static", SS_LEFT | WS_CHILD, 2, 127, 47, 8
	CONTROL "Comments:", -1, "static", SS_LEFT | WS_CHILD, 2, 143, 50, 8
	CONTROL "OK", 1, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 69, 162, 30, 14
	CONTROL "Cancel", 2, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 111, 162, 30, 14
	CONTROL "Search", ID_SEARCH, "BUTTON", BS_PUSHBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 154, 162, 30, 14
END
SEARCH DIALOG 25, 23, 146, 134
CAPTION "Search"
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | 0xC0L
BEGIN
