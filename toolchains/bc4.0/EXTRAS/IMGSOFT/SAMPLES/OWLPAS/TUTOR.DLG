ABOUT DIALOG 25, 23, 184, 78
CAPTION "About..."
STYLE WS_POPUP | WS_CAPTION | WS_SYSMENU | 0xC0L
BEGIN
	CONTROL "Tutor - PowerCode Tutorial", -1, "STATIC", WS_CHILD | WS_VISIBLE | WS_GROUP | 0x1L, 1, 15, 184, 8
	CONTROL "OK", 1, "BUTTON", WS_CHILD | WS_VISIBLE | WS_GROUP | WS_TABSTOP | 0x1L, 76, 60, 32, 14
	CONTROL "Generated with PowerCode", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 1, 30, 184, 8
	CONTROL "The Extensible Application Generator", -1, "STATIC", SS_CENTER | WS_CHILD | WS_VISIBLE | WS_GROUP, 1, 46, 184, 8
END
ADDRESS DIALOG 9, 27, 253, 183
CAPTION "Address Book"
STYLE WS_POPUP | WS_CAPTION	| WS_SYSMENU
BEGIN
	CONTROL "Address Type", -1, "STATIC", SS_LEFT | WS_CHILD | WS_VISIBLE | WS_GROUP, 2, 13, 55, 8
	CONTROL "", ID_ADDTYPE, "COMBOBOX", CBS_DROPDOWN | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 66, 11, 90, 62
	CONTROL "Male", ID_MALE, "BUTTON", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 168, 11, 30, 12
	CONTROL "Female", ID_FEMALE, "BUTTON", BS_AUTORADIOBUTTON | WS_CHILD | WS_VISIBLE | WS_TABSTOP, 208, 11, 39, 12
	CONTROL "Name: Last, First", -1, "static", SS_LEFT | WS_CHILD, 2, 30, 60, 8
	CONTROL "", ID_LNAME, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 67, 29, 73, 12
	CONTROL "", ID_NAME, "edit", ES_LEFT | ES_AUTOHSCROLL | WS_BORDER | WS_TABSTOP | WS_CHILD, 141, 29, 70, 12
	CONTROL "Title", -1, "static", SS_LEFT | WS_CHILD, 2, 46, 39, 8
