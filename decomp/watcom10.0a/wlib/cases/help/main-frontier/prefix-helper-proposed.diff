+static int prefix_callbacks(int finished)
+{
+    unsigned i;
+    BYTE rows[30];
+    DWORD callback, access, release, provider, signal_init;
+    if (!memory(0x420ac8, rows, sizeof(rows)) ||
+        !memory(0x420990, &access, 4) || !memory(0x420998, &release, 4) ||
+        access != 0x418d82 || release != 0x418d82 ||
+        !memory(0x420974,&provider,4) || provider!=0x418d7d ||
+        !memory(0x4209ac,&signal_init,4) || signal_init!=0x418267) return 0;
+    for (i = 0; i < 5; ++i) {
+        memcpy(&callback, rows + i*6 + 2, 4);
+        if (callback != prefix_init[i] || rows[i*6+1] != (i == 4 ? 2 : 32) ||
+            rows[i*6] != (finished ? 2 : 0)) return 0;
+    }
+    fprintf(events,"prefix-bootstrap-callbacks state=%s slots=5 access=%08lx release=%08lx\n",
+            finished ? "finished" : "initial",access,release);
