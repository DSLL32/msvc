+    }
+    for (i = 0; i < 32; ++i) {
+        s = armed_state(); c = after_context(); c.flags ^= 1UL << i;
+        CHECK(rg_finish_step(&s,7,0x80000004UL,1,&c,0x10000003UL) == RG_STEP);
