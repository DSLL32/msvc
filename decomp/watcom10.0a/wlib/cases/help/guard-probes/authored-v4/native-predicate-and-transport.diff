+    s = stepping(); c = before_context(); CHECK(rg_confirm_arm(&s,7,&c) == RG_STEP);
+    s = stepping(); c = arm_context(); ++c.pc; CHECK(rg_confirm_arm(&s,7,&c) == RG_STEP);
