/* Case-bound external MSPDB response host; never part of CL's target graph. */
#define _GNU_SOURCE
#define RECON_SHIM_IMPL
#include <stdint.h>
#include <unistd.h>
#include <fcntl.h>
#include <sys/socket.h>
#include <sys/stat.h>
#include "../src/cl.h"
#include "../src/mre.h"
#include <recon.h>

static int channel = -1;
static unsigned phase;
static unsigned char roles[8]; /* Opaque identities only, never target-readable objects. */
static char identity[65];
static char **initial_environment;
static WCHAR *initial_os_environment;
static unsigned initial_os_units;
static unsigned char *configuration, *cursor, *limit, *idb_bytes;
static unsigned configuration_size, idb_size;
static PendingWork *pending_work;
extern unsigned mre_call_count;

static void fail(const char *why) { recon_unsupported(why); }
static void *take(unsigned count)
{
    void *result = cursor;
    if (count > (unsigned)(limit-cursor)) fail("truncated MRE host binding");
    cursor += count;
    return result;
}
static unsigned number(void)
{
    unsigned result;
    memcpy(&result,take(4),4);
    return result;
}
static char *configuration_text(void)
{
    unsigned count=number();
    char *result;
    if (count>32767) fail("oversized MRE host string");
    result=malloc(count+1);
    if (!result) fail("MRE host allocation");
    memcpy(result,take(count),count);result[count]=0;
    if (memchr(result,0,count)) fail("embedded MRE host NUL");
    return result;
}
static void transfer(void *buffer,unsigned size,int writing)
{
    unsigned char *bytes=buffer;
    while (size) {
        ssize_t result=writing?send(channel,bytes,size,MSG_NOSIGNAL):recv(channel,bytes,size,0);
        if (result<0 && errno==EINTR) continue;
        if (result<=0) fail("MRE host channel closed or incomplete");
        bytes+=result;size-=(unsigned)result;
    }
}
static void exchange(unsigned kind,const void *payload,unsigned size)
{
    unsigned header[4],answer[2];
    if (channel<0 || size>2*1024*1024) fail("unbound or oversized MRE host request");
    header[0]=0x3145524d;header[1]=kind;header[2]=size;header[3]=(unsigned)getpid();
    transfer(header,16,1);transfer(identity,64,1);transfer((void*)payload,size,1);
    transfer(answer,8,0);
    if (answer[0]!=0x31414d52 || answer[1]!=kind) fail("MRE host response mismatch");
}
static void word(FILE *file,unsigned value)
{
    if (fwrite(&value,4,1,file)!=1) fail("MRE host request encoding");
}
static void text(FILE *file,const char *value)
{
    unsigned size;
    word(file,(unsigned)(uintptr_t)value);
    if (!value) return;
    size=(unsigned)strnlen(value,32768);
    if (size>32767) fail("unterminated MRE string input");
    word(file,size);
    if (fwrite(value,1,size,file)!=size) fail("MRE host string encoding");
}
static void vector(FILE *file,char **values)
{
    unsigned count;
    if (!values) fail("unbound MRE CRT vector");
    for (count=0;values[count];++count)
        if (count==4096) fail("oversized MRE CRT vector");
    word(file,(unsigned)(uintptr_t)values);word(file,count);
    for (count=0;values[count];++count) text(file,values[count]);
}
static void handle(FILE *file,long handle_value)
{
    struct stat info;
    off_t offset;
    int descriptor=(int)handle_value-1;
    if (handle_value<=0 || fstat(descriptor,&info)) fail("unknown MRE handle");
    word(file,(unsigned)handle_value);
    word(file,S_ISREG(info.st_mode)?1:S_ISCHR(info.st_mode)?2:0);
    word(file,(unsigned)info.st_dev);word(file,(unsigned)((uint64_t)info.st_dev>>32));
    word(file,(unsigned)info.st_ino);word(file,(unsigned)((uint64_t)info.st_ino>>32));
    offset=lseek(descriptor,0,SEEK_CUR);
    if (offset<0 && !S_ISCHR(info.st_mode)) fail("unknown MRE handle position");
    word(file,(unsigned)offset);word(file,(unsigned)((uint64_t)offset>>32));
}
/* Read-only host observation. Save errors before libc/socket work and restore
 * them afterwards; external MRE effects are applied separately below. */
static void observe(unsigned kind,void *owner_out,const char *path,void *error_out,
                    char *message,BOOL reproducible_arg,BOOL write_arg,
                    Mre *engine,void *driver_out,MreDriver *mre_driver)
{
    int saved_errno=errno;
    unsigned long saved_dos=recon_doserrno;
    DWORD saved_last=recon_GetLastError();
    FILE *file;
    char *bytes=NULL,*cwd;
    size_t size=0;
    unsigned i,count;
    Option *option;
    struct stat info;
    file=open_memstream(&bytes,&size);
    if (!file) fail("MRE host observation allocation");
    word(file,saved_errno);word(file,saved_dos);word(file,saved_last);
    word(file,recon_controlfp(0,0));word(file,recon_fmode);word(file,recon_commode);
    word(file,recon_mb_cur_max);word(file,recon_mb_codepage);word(file,recon_lc_codepage);
    for (i=0;i<6;++i) word(file,recon_lc_handle[i]);
    if (fwrite(recon_mbctype,1,257,file)!=257 || fwrite(recon_pctype-1,2,257,file)!=257)
        fail("MRE host table observation");
    word(file,(unsigned)(uintptr_t)recon_pctype);
    vector(file,recon_crt_environment);vector(file,recon_crt_initenv);
    word(file,(unsigned)(uintptr_t)recon_crt_os_environment);
    word(file,(unsigned)recon_crt_os_environment_units);word(file,recon_crt_environment_updates);
    if (!recon_crt_os_environment || recon_crt_os_environment_units>65536 ||
        fwrite(recon_crt_os_environment,2,recon_crt_os_environment_units,file)!=recon_crt_os_environment_units)
        fail("MRE host OS namespace observation");
    if (fwrite(recon_iob,32,3,file)!=3) fail("MRE host FILE observation");
    for (i=0;i<3;++i) {
        word(file,recon_osfile[i]);handle(file,recon_get_osfhandle(i));
        handle(file,(long)(intptr_t)recon_GetStdHandle(STD_INPUT_HANDLE-i));
    }
    if (recon_nhandle>256) fail("MRE descriptor table bound");
    count=0;
    for (i=0;i<recon_nhandle;++i) if (recon_osfile[i]&1) ++count;
    word(file,count);
    for (i=0;i<recon_nhandle;++i) if (recon_osfile[i]&1) word(file,i);
    word(file,recon_osfile[3]);
    if (recon_osfile[3]&1) {
        long h=recon_get_osfhandle(3);
        unsigned char buffer[25600];
        int fd=(int)h-1;
        handle(file,h);
        word(file,(unsigned)fcntl(fd,F_GETFD));word(file,(unsigned)fcntl(fd,F_GETFL));
        if (fstat(fd,&info) || info.st_size!=sizeof(buffer) || pread(fd,buffer,sizeof(buffer),0)!=sizeof(buffer))
            fail("MRE owned IDB content observation");
        word(file,sizeof(buffer));
        if (fwrite(buffer,1,sizeof(buffer),file)!=sizeof(buffer)) fail("MRE IDB observation encoding");
    }
    word(file,(unsigned)(uintptr_t)driver);
    if (fwrite(driver,4,11,file)!=11 || fwrite(option_buffer,1,1024,file)!=1024)
        fail("MRE actual target observation");
    count=0;
    for (option=driver->options;option;option=option->next)
        if (++count>4096) fail("MRE option list bound");
    word(file,count);
    for (option=driver->options;option;option=option->next) {
        word(file,(unsigned)(uintptr_t)option);
        if (fwrite(option,4,6,file)!=6) fail("MRE option record observation");
        text(file,option->matching);text(file,option->name);text(file,option->value);
    }
    word(file,minimal_rebuild);word(file,reproducible);word(file,first_dependency_scan);
    word(file,interrupted);word(file,pass_running);
    text(file,pdb_name);
    word(file,(unsigned)(uintptr_t)owner_out);text(file,path);
    word(file,(unsigned)(uintptr_t)error_out);word(file,(unsigned)(uintptr_t)message);
    word(file,reproducible_arg);word(file,write_arg);
    word(file,(unsigned)(uintptr_t)engine);word(file,(unsigned)(uintptr_t)driver_out);
    word(file,(unsigned)(uintptr_t)mre_driver);
    /* Output payloads are read only after their actual external write. */
    word(file,kind==2 && owner_out?(unsigned)(uintptr_t)*(Mre**)owner_out:0);
    word(file,kind==2 && error_out?(unsigned)*(int*)error_out:0);
    word(file,kind==4 && driver_out?(unsigned)(uintptr_t)*(MreDriver**)driver_out:0);
    cwd=getcwd(NULL,0);
    if (!cwd) fail("MRE native CWD observation");
    text(file,cwd);free(cwd);
    if (kind==7 || kind==8) {
        if (!pending_work) fail("missing MRE fourth-call record");
        word(file,(unsigned)(uintptr_t)pending_work);
        if (fwrite(pending_work,1,sizeof(*pending_work),file)!=sizeof(*pending_work))
            fail("MRE pending input observation");
    }
    if (fclose(file) || !bytes || size>2*1024*1024) fail("MRE request completion");
    exchange(kind,bytes,(unsigned)size);free(bytes);
    errno=saved_errno;recon_doserrno=saved_dos;recon_SetLastError(saved_last);
}

char **mre_bind_entry(int argc,char **argv,char **envp)
{
    const char *fd_text=getenv("CL_MRE_FD"),*path=getenv("CL_MRE_CONFIG");
    const char *profile=getenv("CL_ENTRY_PROFILE");
    char *end;
    FILE *file;
    long size,fd;
    unsigned i,count;
    if (!fd_text && !path) {
        if (profile && !strcmp(profile,"mre-object-canonical-msvcrt-v1")) fail("unbound MRE case");
        return envp;
    }
    if (!fd_text || !path || channel>=0 || argc!=8 || !profile || strcmp(profile,"mre-object-canonical-msvcrt-v1")) fail("incomplete MRE host binding");
    errno=0;fd=strtol(fd_text,&end,10);
    if (!*fd_text || *end || errno || fd<0 || fd>0x7fffffff) fail("invalid MRE host descriptor");
    channel=(int)fd;
    file=fopen(path,"rb");
    if (!file || fseek(file,0,SEEK_END) || (size=ftell(file))<76 || size>262144 || fseek(file,0,SEEK_SET))
        fail("invalid MRE host configuration");
    configuration=malloc((unsigned)size);configuration_size=(unsigned)size;
    if (!configuration || fread(configuration,1,configuration_size,file)!=configuration_size || fclose(file))
        fail("incomplete MRE host configuration");
    cursor=configuration;limit=cursor+configuration_size;
    if (memcmp(take(4),"RCM1",4) || number()!=1) fail("unknown MRE binding format");
    memcpy(identity,take(64),64);
    for (i=0;i<64;++i) if (!strchr("0123456789abcdef",identity[i])) fail("invalid MRE binding identity");
    exchange(0,configuration,configuration_size);
    count=number();
    if (!count || count>4096) fail("invalid MRE initial environment count");
    initial_environment=calloc(count+1,sizeof(char*));
    if (!initial_environment) fail("MRE namespace allocation");
    for (i=0;i<count;++i) initial_environment[i]=configuration_text();
    initial_os_units=number();
    if (initial_os_units<2 || initial_os_units>65536) fail("invalid MRE OS block size");
    initial_os_environment=malloc(initial_os_units*2);
    if (!initial_os_environment) fail("MRE OS namespace allocation");
    memcpy(initial_os_environment,take(initial_os_units*2),initial_os_units*2);
    idb_size=number();
    if (idb_size!=25600) fail("unknown MRE IDB size");
    idb_bytes=take(idb_size);
    if (cursor!=limit) fail("trailing MRE configuration bytes");
    recon_crt_bind_arguments(argc,argv,initial_environment);
    *recon_p_initenv()=initial_environment;
    recon_crt_bind_os_environment(initial_os_environment,initial_os_units,
        "e390b0529fb9ee1214bb68302a4658b578134d92ab76bc5eb48f3badd843d210");
    return initial_environment;
}

BOOL mre_open(Mre **owner,const char *path,int *error,char *message,BOOL reproducible_arg,BOOL write_arg)
{
    int descriptor;
    if (channel<0 || phase || !owner || !error || message!=option_buffer ||
        !path || strcmp(path,"case.idb") || reproducible_arg || write_arg!=TRUE)
        fail("unknown MRE Open inputs or lifecycle");
    observe(1,owner,path,error,message,reproducible_arg,write_arg,NULL,NULL,NULL);
    /* Only captured external effects: use genuine shared file ownership, then
     * the actual dependency's outputs/errors. Never fill target app globals. */
    descriptor=recon_sopen(path,0x8182,0x10,0x180);
    if (descriptor!=3 || recon_osfile[3]!=0x11 ||
        recon_write(descriptor,idb_bytes,idb_size)!=(int)idb_size ||
        recon_lseek(descriptor,1024,SEEK_SET)!=1024)
        fail("MRE genuine descriptor effect mismatch");
    *owner=(Mre*)roles;*error=0;
    errno=2;recon_doserrno=2;recon_SetLastError(0);
    phase=1;++mre_call_count;
    observe(2,owner,path,error,message,reproducible_arg,write_arg,NULL,NULL,NULL);
    return TRUE;
}
DWORD mre_query(Mre *owner,MreDriver **out)
{
    if (channel<0 || phase!=1 || owner!=(Mre*)roles || !out)
        fail("unknown MRE Query inputs or lifecycle");
    observe(3,NULL,NULL,NULL,NULL,FALSE,FALSE,owner,out,NULL);
    *out=(MreDriver*)(roles+4);phase=2;++mre_call_count;
    observe(4,NULL,NULL,NULL,NULL,FALSE,FALSE,owner,out,NULL);
    /* CL ignores this word; retain the observed driver's alias without claiming
     * a BOOL result or dependency-object content. */
    return (DWORD)(uintptr_t)*out;
}
void mre_init(MreDriver *mre_driver)
{
    if (channel<0 || phase!=2 || mre_driver!=(MreDriver*)(roles+4))
        fail("unknown MRE Init inputs or lifecycle");
    observe(5,NULL,NULL,NULL,NULL,FALSE,FALSE,NULL,NULL,mre_driver);
    phase=3;++mre_call_count;
    observe(6,NULL,NULL,NULL,NULL,FALSE,FALSE,NULL,NULL,mre_driver);
}

/* Exact fourth external response only: no pending work or file changes. The
 * controller authenticates every actual input before acknowledging this call. */
BOOL mre_files_out_of_date(MreDriver *mre_driver,void *work)
{
    if (channel<0 || phase!=3 || mre_driver!=(MreDriver*)(roles+4) || !work)
        fail("unknown MRE FilesOutOfDate inputs or lifecycle");
    pending_work=(PendingWork*)work;
    observe(7,NULL,NULL,NULL,NULL,FALSE,FALSE,NULL,NULL,mre_driver);
    phase=4;++mre_call_count;
    observe(8,NULL,NULL,NULL,NULL,FALSE,FALSE,NULL,NULL,mre_driver);
    return TRUE;
}
