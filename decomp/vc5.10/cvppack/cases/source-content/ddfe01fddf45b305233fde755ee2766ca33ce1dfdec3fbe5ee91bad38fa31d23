#ifndef CV510_WIDEN_H
#define CV510_WIDEN_H
#include "cvpack.h"
#include <recon.h>

typedef struct WidenTi WidenTi;
typedef struct WidenOutput {
    unsigned bytes, fixups;
    unsigned char *output;
    unsigned long *records;
} WidenOutput;
/* Thiscall's ECX object and callee-cleaned stack are expressible in C through
 * fastcall with an unused EDX argument. EDX is not part of this method ABI. */
typedef void (__fastcall *WidenDestroy)(WidenTi *, void *);
typedef void (__fastcall *WidenUnknown)(WidenTi *, void *);
typedef int (__fastcall *WidenRecord)(WidenTi *, void *, void *, const void *, unsigned *);
typedef int (__fastcall *WidenSymbols)(WidenTi *, void *, WidenOutput *, const void *, unsigned, unsigned);
typedef struct WidenVTable {
    WidenDestroy destroy;
    WidenUnknown reserved1, reserved2;
    WidenRecord record;
    WidenUnknown reserved4, reserved5, reserved6, reserved7;
    WidenSymbols query, emit;
} WidenVTable;
struct WidenTi { const WidenVTable *vtable; };
#endif
