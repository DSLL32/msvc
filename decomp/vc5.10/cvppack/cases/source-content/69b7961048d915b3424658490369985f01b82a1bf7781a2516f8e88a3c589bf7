static void configure(void)
{
    char *value, *next;
    output_directory_mode = getenv("VC510_CVPACK_OUTPUT_DIRECTORY") != NULL;
    complete_sort_mode = getenv("VC510_CVPACK_COMPLETE_SORT") != NULL;
    output_buffer_mode = getenv("VC510_CVPACK_OUTPUT_BUFFER") != NULL;
    subsection_mode = getenv("VC510_CVPACK_SUBSECTIONS") != NULL;
    public_writer_mode = getenv("VC510_CVPACK_PUBLIC_WRITER") != NULL;
    public_padding_mode = getenv("VC510_CVPACK_PUBLIC_PADDING") != NULL;
    name_hash_mode = getenv("VC510_CVPACK_NAME_HASH") != NULL;
    name_hash_complete_mode = getenv("VC510_CVPACK_NAME_HASH_COMPLETE") != NULL;
    value = getenv("VC510_CVPACK_DATA");
    while (value && *value && watch_count < 256) {
        if (sscanf(value, "%lx:%lu", &watched_address[watch_count], &watched_size[watch_count]) != 2) break;
        ++watch_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_ARGUMENTS");
    while (value && *value && argument_count < 64) {
        if (sscanf(value, "%lx:%lu:%c:%lu:%lu", &argument_entry[argument_count], &argument_slot[argument_count], &argument_kind[argument_count], &argument_buffer_count[argument_count], &argument_buffer_offset[argument_count]) != 5) break;
        ++argument_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_PROBES");
    while (value && *value && probe_count < 128) {
        if (sscanf(value, "%lx:%63[^,]", &probe_sites[probe_count], probe_names[probe_count]) != 2) break;
        ++probe_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_BLOBS");
    while (value && *value && blob_count < 64) {
        blob_pointer[blob_count] = 0xffffffffUL;
        blob_count_width[blob_count] = 4;
        if (sscanf(value, "%lx:%lu:%lu:%lu:%lx:%lu:%lu", &blob_address[blob_count], &blob_size[blob_count],
                   &blob_pointer[blob_count], &blob_child_size[blob_count], &blob_count_address[blob_count], &blob_element_size[blob_count], &blob_count_width[blob_count]) < 2) break;
        ++blob_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_GRAPHS");
    while (value && *value && graph_count < 64) {
        graph_string[graph_count] = graph_handle[graph_count] = 0xffffffffUL;
        graph_payload[graph_count] = graph_payload_length[graph_count] = 0xffffffffUL;
        if (sscanf(value, "%lx:%lu:%lu:%lx:%lu:%lu:%lu:%lu:%lu", &graph_address[graph_count], &graph_size[graph_count],
                   &graph_link[graph_count], &graph_count_address[graph_count], &graph_string[graph_count],
                   &graph_literal[graph_count], &graph_handle[graph_count], &graph_payload[graph_count], &graph_payload_length[graph_count]) < 4) break;
        ++graph_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
}

static void string(FILE *log, HANDLE process, DWORD address)
{
    unsigned char byte;
    unsigned i;
    fprintf(log, "string %08lx ", address);
    for (i = 0; i < 1024; ++i) {
        if (!read_bytes(process, address + i, &byte, 1)) { fprintf(log, "FAILED\n"); return; }
        fprintf(log, "%02x", byte);
        if (!byte) { fputc('\n', log); return; }
    }
    fprintf(log, "UNBOUNDED\n");
}

static int read_bytes(HANDLE process, DWORD address, void *data, DWORD size)
{
    DWORD actual;
    return ReadProcessMemory(process, (void *)address, data, size, &actual) && actual == size;
}

