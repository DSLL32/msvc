/* Saved PRE-free typed roots may identify still-live child nodes. This observer
 * never fetches a released table from the child or logs it as current memory. */
static int historical_type_table(HANDLE process, DWORD address, void *data, DWORD size)
{
    DWORD i;
    for (i = 7; i < main_free_count; ++i) if (main_free_addresses[i] &&
        address < main_free_addresses[i] + main_free_sizes[i] &&
        main_free_addresses[i] < address + size) {
        if (address < main_free_addresses[i] ||
            size > main_free_sizes[i] - (address - main_free_addresses[i]) ||
            !main_free_before[i]) return 0;
        memcpy(data, main_free_before[i] + address - main_free_addresses[i], size);
        return 1;
    }
    return read_bytes(process, address, data, size);
}

static int write_bytes(HANDLE process, DWORD address, const void *data, DWORD size)
{
    DWORD actual;
    return WriteProcessMemory(process, (void *)address, (void *)data, size, &actual)
        && actual == size && FlushInstructionCache(process, (void *)address, size);
}

static void memory(FILE *log, HANDLE process, DWORD address, DWORD size)
{
    unsigned char *bytes;
    DWORD i;
    for (i = 0; i < main_free_count; ++i) if (main_free_addresses[i] &&
        address < main_free_addresses[i] + main_free_sizes[i] &&
        main_free_addresses[i] < address + size) {
        if (address < main_free_addresses[i] || size > main_free_sizes[i] - (address - main_free_addresses[i]))
            fprintf(log, "released-memory-range-failed %08lx %lu\n", address, size);
        else fprintf(log, "released-memory-omitted %08lx %lu\n", address, size);
        return;
    }
    if (size > 1048576) {
        fprintf(log, "memory-failed %08lx %lu\n", address, size); return;
    }
    bytes = malloc(size ? size : 1);
    if (!bytes || !read_bytes(process, address, bytes, size)) {
        fprintf(log, "memory-failed %08lx %lu\n", address, size);
        free(bytes); return;
    }
    fprintf(log, "memory %08lx ", address);
    for (i = 0; i < size; ++i) fprintf(log, "%02x", bytes[i]);
    fputc('\n', log);
    free(bytes);
}

/* Query only a parent-owned duplicate. Child LastError is recorded before this
 * observer executes; a zero-distance seek leaves the shared file position alone. */
static void file_handle(FILE *log, HANDLE process, DWORD value)
{
    HANDLE duplicate;
    DWORD kind, size, high, position;
    if (!DuplicateHandle(process, (HANDLE)value, GetCurrentProcess(), &duplicate,
                         0, FALSE, DUPLICATE_SAME_ACCESS)) {
        fprintf(log, "file-handle-failed %08lx\n", value);
        return;
    }
    kind = GetFileType(duplicate);
    high = 0;
    size = GetFileSize(duplicate, &high);
    position = SetFilePointer(duplicate, 0, NULL, FILE_CURRENT);
    fprintf(log, "file-handle %08lx %lu %lu %lu %lu\n", value, kind, size, high, position);
    CloseHandle(duplicate);
}

/* Retain complete mapped bytes once per live view, outside the textual log. */
static void mapped_view(FILE *log, HANDLE process, DWORD address, DWORD size)
{
    MEMORY_BASIC_INFORMATION information;
    DWORD i, offset, count;
    unsigned char block[65536];
    char path[MAX_PATH + 40];
    FILE *output;
    for (i = 0; i < captured_view_count; ++i) if (captured_views[i] == address) return;
    if (!size || size > 16 * 1024 * 1024 || captured_view_count >= 128 ||
        VirtualQueryEx(process, (void *)address, &information, sizeof(information)) != sizeof(information)) {
        fprintf(log, "mapped-view-failed %08lx\n", address); return;
    }
    i = ++captured_view_count;
    captured_views[i - 1] = address;
    sprintf(path, "%s-view-%lu.bin", event_path, i);
    output = fopen(path, "wb");
    if (!output) { fprintf(log, "mapped-view-failed %08lx\n", address); return; }
    for (offset = 0; offset < size; offset += count) {
        count = size - offset;
        if (count > sizeof(block)) count = sizeof(block);
        if (!read_bytes(process, address + offset, block, count) || fwrite(block, 1, count, output) != count) break;
    }
    fclose(output);
    if (offset != size) { fprintf(log, "mapped-view-failed %08lx\n", address); return; }
    fprintf(log, "mapped-view %08lx %lu %08lx %lu %lu %lu %lu %lu\n", address, size,
        (DWORD)information.AllocationBase, information.RegionSize, information.Protect,
        information.State, information.Type, i);
}

static void linked_memory(FILE *log, HANDLE process, DWORD head, DWORD size, DWORD link, DWORD text, DWORD handle, DWORD payload, DWORD payload_length)
{
    DWORD seen[128], count = 0, i, value;
    while (head && count < 128) {
        for (i = 0; i < count; ++i) if (seen[i] == head) return;
        seen[count++] = head;
        memory(log, process, head, size);
        if (text <= size - 4 && read_bytes(process, head + text, &value, 4) && value)
            string(log, process, value);
        if (handle <= size - 4 && read_bytes(process, head + handle, &value, 4) && value)
            file_handle(log, process, value);
        if (size == 40 && text == 0 && handle == 16 && read_bytes(process, head + 20, &value, 4) && value) {
            DWORD length;
            if (read_bytes(process, head + 24, &length, 4)) mapped_view(log, process, value, length);
        }
        if (payload <= size - 4 && payload_length <= size - 4 &&
            read_bytes(process, head + payload, &value, 4) && value) {
            DWORD length;
            if (read_bytes(process, head + payload_length, &length, 4)) memory(log, process, value, length);
        }
        if (size == 48 && link == 44 && payload == 12 && payload_length == 16 &&
            read_bytes(process, head + 28, &value, 4) && value) {
            DWORD length;
            if (read_bytes(process, head + 32, &length, 4)) memory(log, process, value, length);
        }
        if (!read_bytes(process, head + link, &head, 4)) return;
    }
    if (head) fprintf(log, "memory-graph-unbounded\n");
}

/* These are caller-side API observations, not reconstructed dependency code.
 * Preserve opaque object identity/vptr only; never inspect its private fields. */
static void widen_state(FILE *log, HANDLE process, CONTEXT *context, DWORD site)
{
    DWORD args[4], object, table, length, description[4];
    unsigned short record_length;
    if (site == 0x41029c) {
        if (!read_bytes(process, context->Esp, args, 12)) return;
        widen_output = args[0];
        fprintf(log, "widen create-call %08lx %lu %lu\n", args[0], args[1], args[2]);
    } else if (site == 0x4102a2) {
        if (!read_bytes(process, widen_output, &object, 4) || !read_bytes(process, object, &table, 4)) return;
        fprintf(log, "widen create-return %lu %08lx %08lx\n", context->Eax, object, table);
        memory(log, process, widen_output, 4);
        memory(log, process, object, 4);
        memory(log, process, table, 40);
    } else if (site == 0x4102d5 || site == 0x4102f7 || site == 0x41031a) {
        widen_object = context->Ecx;
        length = site == 0x4102d5 ? 12 : 16;
        if (!read_bytes(process, context->Esp, widen_arguments, length)) return;
        fprintf(log, "widen method-call %u %08lx %08lx %08lx %08lx %08lx\n",
                site == 0x4102d5 ? 12 : site == 0x4102f7 ? 32 : 36,
                widen_object, widen_arguments[0], widen_arguments[1], widen_arguments[2],
                site == 0x4102d5 ? 0 : widen_arguments[3]);
        if (site == 0x4102d5) {
            if (!read_bytes(process, widen_arguments[1], &record_length, 2)) return;
            memory(log, process, widen_arguments[1], (DWORD)record_length + 2);
            memory(log, process, widen_arguments[2], 4);
        } else {
            memory(log, process, widen_arguments[1], widen_arguments[2]);
            memory(log, process, widen_arguments[0], 16);
            if (site == 0x41031a && read_bytes(process, widen_arguments[0], description, 16)) {
                widen_capacities[0] = description[0];
                widen_capacities[1] = description[1];
                memory(log, process, description[2], description[0]);
                memory(log, process, description[3], description[1] * 8);
            }
        }
    } else if (site == 0x4102d8 || site == 0x4102fa || site == 0x41031d) {
        fprintf(log, "widen method-return %u %08lx %lu\n",
                site == 0x4102d8 ? 12 : site == 0x4102fa ? 32 : 36, widen_object, context->Eax);
        if (site == 0x4102d8) {
            if (!read_bytes(process, widen_arguments[2], &length, 4)) return;
            memory(log, process, widen_arguments[2], 4);
            memory(log, process, widen_arguments[0], length);
        } else {
            memory(log, process, widen_arguments[0], 16);
            if (site == 0x4102fa) memory(log, process, widen_arguments[1], widen_arguments[2]);
            if (site == 0x41031d && read_bytes(process, widen_arguments[0], description, 16)) {
                memory(log, process, widen_arguments[1], widen_arguments[2]);
                memory(log, process, description[2], widen_capacities[0]);
                memory(log, process, description[3], widen_capacities[1] * 8);
            }
        }
    } else if (site == 0x4102b6) {
        widen_release_object = context->Ecx;
        fprintf(log, "widen destroy %08lx\n", context->Ecx);
        memory(log, process, context->Ecx, 4);
        memory(log, process, context->Eax, 4);
        /* EDI is the copied output cursor in this actual caller; retain the
         * initialized payload before a subsequent module reuses the buffer. */
        if (read_bytes(process, widen_arguments[0], description, 16)) {
            fprintf(log, "widen copied %08lx %lu\n", context->Edi - description[0], description[0]);
            memory(log, process, context->Edi - description[0], description[0]);
        }
    } else if (site == 0x4053ad) {
        fprintf(log, "widen destroy-return %08lx\n", widen_release_object);
    }
}

static void state(FILE *log, HANDLE process, CONTEXT *context, DWORD entry, int full_graphs)
{
    DWORD i, j, value, count, item;
    if (name_hash_complete_mode && name_hash_started) {
        namehash_complete_observation(log, process, context, entry);
        if (entry==0x40ec07 || entry==0x40ec0c || entry==0x40ec60 || entry==0x40ec65 || entry==0x40ecdc || entry==0x40ece1 || entry==0x40ed1d || entry==0x40ed22 || entry==0x40ebbb || entry==0x40ebc0 || entry==0x40ec6a || entry==0x40ec6f || entry==0x40ed87 || entry==0x40ed89 || entry==0x40ed97 || entry==0x40ed99 || entry==0x40eda8 || entry==0x40edaa) return;
    }
    if (name_hash_mode && !name_hash_started && (entry == 0x40ff9d || entry == 0x40ffa2 || entry == 0x40ffaa || entry == 0x40ffaf)) return;
    if (name_hash_mode && name_hash_started && (entry == 0x40e9aa || entry == 0x40e9af || entry == 0x40e9e9 || entry == 0x40e9ee || entry == 0x40eb0a || entry == 0x40eb0f || entry == 0x40eba0 || entry == 0x40eba5 || entry == 0x40ebb0 || entry == 0x40ebb5 || entry == 0x40ff9d || entry == 0x40ffa2 || entry == 0x40ffaa || entry == 0x40ffaf)) { name_hash_observation(log, process, context, entry); return; }
    if (name_hash_mode && entry == 0x40e920) name_hash_observation(log, process, context, entry);
    if (name_hash_mode && entry == 0x410010 && full_graphs && !name_hash_complete_mode) name_hash_observation(log, process, context, entry);
    if (public_padding_mode && entry == 0x40fad1) {
        fprintf(log, "public-padding-return %lu %08lx %08lx %08lx %08lx %08lx\n", context->Eax, context->Esp, context->Ebx, context->Esi, context->Edi, context->Ebp); return;
    }
    if (public_padding_mode && entry == 0x40f960) public_padding_before(log, process, context);
    if (subsection_mode && (entry == 0x4068a4 || entry == 0x4069d9)) {
        subsection_observation(log, process, context, entry); return;
    }
    if (output_buffer_mode && (entry == 0x4100f3 || entry == 0x4100f5)) {
        output_buffer_allocation(log, process, context, entry); return;
    }
    if (complete_sort_mode && (entry == 0x4063f4 || entry == 0x406418 || entry == 0x40642c ||
        entry == 0x40643e || entry == 0x406447 || entry == 0x406454 || entry == 0x40645a)) {
        sort_callback(log, process, context, entry);
        return;
    }
    fprintf(log, "registers %08lx %08lx %08lx %08lx %08lx %08lx %08lx %08lx\n",
            context->Eax, context->Ebx, context->Ecx, context->Edx,
            context->Esi, context->Edi, context->Ebp, context->Esp);
    memory(log, process, context->Esp, name_hash_mode && entry == 0x410010 ? 256 : 128);
    memory(log, process, 0x412124, 28);
    memory(log, process, 0x412988, 12);
    memory(log, process, 0x412588, 1024);
    /* NT i386 TEB.LastErrorValue; TEB is supplied by the debug event, not
     * guessed from a target allocation or read from the debugger's thread. */
    if (active_teb && read_bytes(process, active_teb + 0x34, &value, 4))
        fprintf(log, "last-error %lu\n", value);
    for (i = 0; i < watch_count; ++i) memory(log, process, watched_address[i], watched_size[i]);
    for (i = 0; full_graphs && i < graph_count; ++i) {
        if (graph_literal[i]) value = graph_address[i];
        else if (!read_bytes(process, graph_address[i], &value, 4)) continue;
        if (!graph_count_address[i] && !graph_literal[i])
            linked_memory(log, process, value, graph_size[i], graph_link[i], graph_string[i], graph_handle[i], graph_payload[i], graph_payload_length[i]);
        else if (((count = graph_literal[i]) || read_bytes(process, graph_count_address[i], &count, 4)) && count <= 128) {
            memory(log, process, value, count * 4);
            for (j = 0; j < count; ++j) if (read_bytes(process, value + j * 4, &item, 4))
                linked_memory(log, process, item, graph_size[i], graph_link[i], graph_string[i], graph_handle[i], graph_payload[i], graph_payload_length[i]);
        }
    }
    for (i = 0; full_graphs && i < blob_count; ++i) {
        if (read_bytes(process, blob_address[i], &value, 4) && value) {
            DWORD bytes = blob_size[i];
            if (blob_count_address[i]) {
                count = 0;
                if (!read_bytes(process, blob_count_address[i], &count, blob_count_width[i]) || count > 65536 / blob_element_size[i]) {
                    fprintf(log, "blob-observation-failed\n"); continue;
                }
                bytes = count * blob_element_size[i];
            }
            if (output_directory_mode && blob_address[i] == 0x4153b8) {
                if (directory_capacity < 72 || directory_capacity % 12) { fprintf(log, "blob-observation-failed\n"); continue; }
                bytes = directory_capacity - 72;
            }
            memory(log, process, value, bytes);
            if (blob_child_size[i] && blob_pointer[i] <= blob_size[i] - 4 &&
                read_bytes(process, value + blob_pointer[i], &item, 4) && item)
                memory(log, process, item, blob_child_size[i]);
        }
    }
    /* Full defined record-table storage and the owned type segment capacity.
     * The decoder compares only bytes initialized by clearing/actual reads. */
    if (full_graphs && read_bytes(process, 0x4132c4, &value, 4) && value &&
        read_bytes(process, 0x4132e0, &count, 4)) {
        if (count > 32768) fprintf(log, "blob-observation-failed\n");
        else {
            DWORD entry, k, child, part;
            unsigned char record[32];
            memory(log, process, value, count * 32);
            for (entry = 0; entry < count; ++entry) {
                if (!historical_type_table(process, value + entry * 32, record, 32)) {
                    fprintf(log, "blob-observation-failed\n"); return;
                }
                if (!(record[29] & 1)) continue;
                for (part = 0; part < 2; ++part) {
                    memcpy(&child, record + (part ? 24 : 16), 4);
                    for (k = cleared_count; k; --k) if (cleared_addresses[k-1] == child) break;
                    if (!k || !child || !cleared_sizes[k-1] || cleared_sizes[k-1] > 65536) {
                        fprintf(log, "blob-observation-failed\n"); return;
                    }
                    memory(log, process, child, cleared_sizes[k-1]);
                }
            }
        }
    }
    if (full_graphs && read_bytes(process, 0x41564c, &value, 4) && value &&
        read_bytes(process, value, &item, 4) && item &&
        read_bytes(process, 0x415680, &count, 4)) {
        if (count > 65512) count = 65512;
        memory(log, process, item, count);
    }
    if (full_graphs && widen_capacities[0]) {
        if (read_bytes(process, 0x412578, &value, 4) && value)
            memory(log, process, value, widen_capacities[0]);
        if (read_bytes(process, 0x41257c, &value, 4) && value)
            memory(log, process, value, widen_capacities[1] * 8);
    }
    if (full_graphs) for (i = 0; i < symbol_output_count; ++i)
        memory(log, process, symbol_output_addresses[i], symbol_output_sizes[i]);
    if (full_graphs) {
      DWORD table;
      for (table = 0; table < 3; ++table) {
        DWORD bucket, node, next_node, visited;
        WORD length;
        if (!read_bytes(process, 0x412cf0 + table * 4, &value, 4) || !value) continue;
