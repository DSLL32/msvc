        nt.Signature != IMAGE_NT_SIGNATURE) return 0;
    name[0] = 0;
    if (nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress) {
        if (!read_bytes(process, base + nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress,
                        &exports, sizeof(exports))) return 0;
        name_address = base + exports.Name;
        if (!read_bytes(process, name_address, name, sizeof(name))) return 0;
        name[sizeof(name)-1] = 0;
    }
    fprintf(log, "module %08lx %s\n", base, name);
    if (!_stricmp(name, "MSVCRT.dll")) loaded_crt_base = base;
    if (_stricmp(name, "MSVCRT.dll")) {
        if (_stricmp(name, "mspdb50.dll") || !getenv("VC510_CVPACK_PDB_PROVIDER")) return 1;
        provider = getenv("VC510_CVPACK_PDB_PROVIDER");
    }
    if (!info->hFile || info->hFile == INVALID_HANDLE_VALUE) return 0;
    size = GetFileSize(info->hFile, &high);
    if (high || !size || size == 0xffffffffUL) return 0;
    output = CreateFileA(provider, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (output == INVALID_HANDLE_VALUE) return 0;
    total = 0;
    while (total < size) {
        request = size - total;
        if (request > sizeof(block)) request = sizeof(block);
        memset(&position, 0, sizeof(position));
        position.Offset = total;
        bytes = 0;
        if (!ReadFile(info->hFile, block, request, &bytes, &position) || bytes != request) {
            CloseHandle(output); return 0;
        }
        if (!WriteFile(output, block, bytes, &name_address, NULL) || name_address != bytes) {
            CloseHandle(output); return 0;
        }
        total += bytes;
    }
    if (total != size || GetFileSize(info->hFile, &high) != size || high) {
        CloseHandle(output); return 0;
    }
    CloseHandle(output);
    fprintf(log, "provider-bytes %lu\n", total);
    return 1;
}

int main(int argc, char **argv)
{
    SECURITY_ATTRIBUTES security;
    STARTUPINFOA startup;
    PROCESS_INFORMATION child;
    DEBUG_EVENT event;
    CONTEXT context;
    HANDLE stdout_file, stderr_file, thread;
    HANDLE threads[64];
    DWORD thread_tebs[64];
    DWORD thread_ids[64], thread_count = 0;
    FILE *log, *plan, *original;
    DWORD address, disposition, entry, i, status, count;
    unsigned char trap = 0xcc;
    int initial_break = 1, done = 0, failed = 0, known;
    char command[2048];
    if (argc != 11) return 90;
    configure();
    strcpy(event_path, argv[5]);
    log = fopen(argv[5], "wb");
    plan = fopen(argv[7], "r");
    original = fopen(argv[8], "rb");
    if (!log || !plan || !original) return 91;
    while (range_count < 256 && fscanf(plan, "%lx %lx %lx", &ranges[range_count].start,
            &ranges[range_count].end, &ranges[range_count].offset) == 3) ++range_count;
    fclose(plan);
    probes_enabled = atoi(argv[10]) || probe_count > 6;
    memset(&security, 0, sizeof(security));
    security.nLength = sizeof(security);
    security.bInheritHandle = TRUE;
    stdout_file = CreateFileA(argv[3], GENERIC_WRITE, FILE_SHARE_READ, &security, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    stderr_file = CreateFileA(argv[4], GENERIC_WRITE, FILE_SHARE_READ, &security, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (stdout_file == INVALID_HANDLE_VALUE || stderr_file == INVALID_HANDLE_VALUE) return 92;
    memset(&startup, 0, sizeof(startup));
    startup.cb = sizeof(startup);
    startup.dwFlags = STARTF_USESTDHANDLES;
    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
    startup.hStdOutput = stdout_file;
    startup.hStdError = stderr_file;
    strcpy(command, argv[2]);
    if (!CreateProcessA(argv[1], command, NULL, NULL, TRUE, DEBUG_ONLY_THIS_PROCESS,
                        NULL, argv[6], &startup, &child)) return 93;
    while (!done && WaitForDebugEvent(&event, 30000)) {
        disposition = DBG_CONTINUE;
        if (event.dwDebugEventCode == CREATE_PROCESS_DEBUG_EVENT) {
            threads[thread_count] = event.u.CreateProcessInfo.hThread;
            thread_tebs[thread_count] = (DWORD)event.u.CreateProcessInfo.lpThreadLocalBase;
            thread_ids[thread_count++] = event.dwThreadId;
            entry = (DWORD)event.u.CreateProcessInfo.lpStartAddress;
            fprintf(log, "process-base %08lx entry %08lx\n", (DWORD)event.u.CreateProcessInfo.lpBaseOfImage, entry);
            if ((DWORD)event.u.CreateProcessInfo.lpBaseOfImage != 0x400000 || entry != 0x410330) failed = 1;
            if (event.u.CreateProcessInfo.hFile) CloseHandle(event.u.CreateProcessInfo.hFile);
        } else if (event.dwDebugEventCode == CREATE_THREAD_DEBUG_EVENT) {
            if (thread_count == 64) failed = 1;
            else {
                threads[thread_count] = event.u.CreateThread.hThread;
                thread_tebs[thread_count] = (DWORD)event.u.CreateThread.lpThreadLocalBase;
                thread_ids[thread_count++] = event.dwThreadId;
            }
        } else if (event.dwDebugEventCode == LOAD_DLL_DEBUG_EVENT) {
            if (!module(log, child.hProcess, &event.u.LoadDll, argv[9])) failed = 1;
            if (event.u.LoadDll.hFile) CloseHandle(event.u.LoadDll.hFile);
        } else if (event.dwDebugEventCode == EXCEPTION_DEBUG_EVENT) {
            address = (DWORD)event.u.Exception.ExceptionRecord.ExceptionAddress;
            status = event.u.Exception.ExceptionRecord.ExceptionCode;
            thread = NULL;
            for (i = 0; i < thread_count; ++i) if (thread_ids[i] == event.dwThreadId) {
                thread = threads[i]; active_teb = thread_tebs[i];
                active_thread = thread; active_thread_id = event.dwThreadId;
            }
            memset(&context, 0, sizeof(context));
            context.ContextFlags = CONTEXT_FULL | (complete_sort_mode ? CONTEXT_FLOATING_POINT : 0);
            if (!thread || !GetThreadContext(thread, &context)) return 94;
            if (status == EXCEPTION_SINGLE_STEP && pending_probe >= 0) {
                context.EFlags &= ~0x100;
                if (!write_bytes(child.hProcess, probe_sites[pending_probe], &trap, 1)) failed = 1;
                pending_probe = -1;
                SetThreadContext(thread, &context);
            } else if (status == EXCEPTION_BREAKPOINT) {
                if (initial_break && (address < 0x401000 || address >= 0x4104c6)) {
                    initial_break = 0;
                    if (probes_enabled) for (i = 0; i < probe_count; ++i) {
                        if (!read_bytes(child.hProcess, probe_sites[i], &probe_bytes[i], 1) ||
                            !write_bytes(child.hProcess, probe_sites[i], &trap, 1)) failed = 1;
                    }
                } else {
                    known = 0;
                    for (i = 0; probes_enabled && i < probe_count; ++i) if (address == probe_sites[i]) {
                        fprintf(log, "%s %08lx eax %08lx\n", probe_names[i], address, context.Eax);
                        state(log, child.hProcess, &context, address, 0);
                        if (!write_bytes(child.hProcess, address, &probe_bytes[i], 1)) failed = 1;
                        context.Eip = address;
                        context.EFlags |= 0x100;
                        pending_probe = i;
                        SetThreadContext(thread, &context);
                        known = 1;
                    }
                    for (i = 0; !known && i < range_count; ++i) if (ranges[i].start == address && !ranges[i].reached) {
                        count = ranges[i].end - address;
                        if (!count || count > sizeof(original_bytes) ||
                            fseek(original, ranges[i].offset, SEEK_SET) ||
                            fread(original_bytes, 1, count, original) != count ||
                            !write_bytes(child.hProcess, address, original_bytes, count)) failed = 1;
                        /* Restoring this function must also restore its probes,
                         * whose bytes were still INT3 in the initial masked image. */
                        if (probes_enabled) {
                            unsigned p;
                            for (p = 0; p < probe_count; ++p) if (probe_sites[p] >= address && probe_sites[p] < ranges[i].end) {
                                if (!read_bytes(child.hProcess, probe_sites[p], &probe_bytes[p], 1) ||
                                    !write_bytes(child.hProcess, probe_sites[p], &trap, 1)) failed = 1;
                            }
                        }
                        ranges[i].reached = 1;
                        fprintf(log, "entry %08lx\n", address);
                        state(log, child.hProcess, &context, address, 0);
                        context.Eip = address;
                        SetThreadContext(thread, &context);
                        known = 1;
                    }
                    if (!known) {
                        fprintf(log, "frontier %08lx\n", address);
                        state(log, child.hProcess, &context, address, 1);
                        TerminateProcess(child.hProcess, 125);
                        done = 1;
                    }
                }
            } else {
                fprintf(log, "exception %08lx %08lx first %lu\n", status, address, event.u.Exception.dwFirstChance);
                state(log, child.hProcess, &context, address, 0);
                TerminateProcess(child.hProcess, 126);
                failed = 1;
                done = 1;
            }
        } else if (event.dwDebugEventCode == EXIT_PROCESS_DEBUG_EVENT) {
            fprintf(log, "exit %lu\n", event.u.ExitProcess.dwExitCode);
            done = 1;
        }
        if (failed) { TerminateProcess(child.hProcess, 127); done = 1; }
        if (!ContinueDebugEvent(event.dwProcessId, event.dwThreadId, disposition)) failed = 1;
        fflush(log);
    }
    if (!done) { fprintf(log, "debug-timeout\n"); TerminateProcess(child.hProcess, 124); failed = 1; }
    WaitForSingleObject(child.hProcess, 10000);
    CloseHandle(child.hProcess);
    CloseHandle(child.hThread);
    CloseHandle(stdout_file);
    CloseHandle(stderr_file);
    fclose(original);
    fclose(log);
    return failed ? 95 : 0;
}
