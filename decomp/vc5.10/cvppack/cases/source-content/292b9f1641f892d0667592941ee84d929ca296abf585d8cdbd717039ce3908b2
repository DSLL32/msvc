/* Explicit original-reference debugger. Never linked into the reconstruction. */
#include <windows.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct RestoreRange {
    DWORD start, end, offset;
    unsigned char reached;
} RestoreRange;

static RestoreRange ranges[256];
static unsigned range_count;
static unsigned char original_bytes[65536];
static DWORD probe_sites[64] = { 0x407667, 0x407669, 0x407641, 0x407647, 0x40761f, 0x407625 };
static char probe_names[64][64] = { "resource-call", "resource-return", "getproc-call", "getproc-return", "loadlibrary-call", "loadlibrary-return" };
static unsigned char probe_bytes[64];
static unsigned probe_count = 6;
static DWORD active_teb;
static int probes_enabled, pending_probe = -1;
static DWORD watched_address[64], watched_size[64], watch_count;
static DWORD argument_entry[64], argument_slot[64], argument_count;
static char argument_kind[64];
static DWORD graph_address[64], graph_size[64], graph_link[64], graph_count_address[64], graph_count;
static DWORD graph_string[64];
static DWORD widen_output, widen_object, widen_arguments[4];
static DWORD widen_capacities[2];
static int read_bytes(HANDLE process, DWORD address, void *data, DWORD size);

static void configure(void)
{
    char *value, *next;
    value = getenv("VC510_CVPACK_DATA");
    while (value && *value && watch_count < 64) {
        if (sscanf(value, "%lx:%lu", &watched_address[watch_count], &watched_size[watch_count]) != 2) break;
        ++watch_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_ARGUMENTS");
    while (value && *value && argument_count < 64) {
        if (sscanf(value, "%lx:%lu:%c", &argument_entry[argument_count], &argument_slot[argument_count], &argument_kind[argument_count]) != 3) break;
        ++argument_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_PROBES");
    while (value && *value && probe_count < 64) {
        if (sscanf(value, "%lx:%63[^,]", &probe_sites[probe_count], probe_names[probe_count]) != 2) break;
        ++probe_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
    value = getenv("VC510_CVPACK_GRAPHS");
    while (value && *value && graph_count < 64) {
        graph_string[graph_count] = 0xffffffffUL;
        if (sscanf(value, "%lx:%lu:%lu:%lx:%lu", &graph_address[graph_count], &graph_size[graph_count],
                   &graph_link[graph_count], &graph_count_address[graph_count], &graph_string[graph_count]) < 4) break;
        ++graph_count;
        next = strchr(value, ',');
        value = next ? next + 1 : NULL;
    }
}

static void string(FILE *log, HANDLE process, DWORD address)
{
    unsigned char byte;
    unsigned i;
    fprintf(log, "string %08lx ", address);
    for (i = 0; i < 1024; ++i) {
        if (!read_bytes(process, address + i, &byte, 1)) { fprintf(log, "FAILED\n"); return; }
        fprintf(log, "%02x", byte);
        if (!byte) { fputc('\n', log); return; }
    }
    fprintf(log, "UNBOUNDED\n");
}

static int read_bytes(HANDLE process, DWORD address, void *data, DWORD size)
{
    DWORD actual;
    return ReadProcessMemory(process, (void *)address, data, size, &actual) && actual == size;
}

static int write_bytes(HANDLE process, DWORD address, const void *data, DWORD size)
{
    DWORD actual;
    return WriteProcessMemory(process, (void *)address, (void *)data, size, &actual)
        && actual == size && FlushInstructionCache(process, (void *)address, size);
}

static void memory(FILE *log, HANDLE process, DWORD address, DWORD size)
{
    unsigned char bytes[65536];
    DWORD i;
    if (size > sizeof(bytes) || !read_bytes(process, address, bytes, size)) {
        fprintf(log, "memory-failed %08lx %lu\n", address, size);
        return;
    }
    fprintf(log, "memory %08lx ", address);
    for (i = 0; i < size; ++i) fprintf(log, "%02x", bytes[i]);
    fputc('\n', log);
}

static void linked_memory(FILE *log, HANDLE process, DWORD head, DWORD size, DWORD link, DWORD text)
{
    DWORD seen[128], count = 0, i, value;
    while (head && count < 128) {
        for (i = 0; i < count; ++i) if (seen[i] == head) return;
        seen[count++] = head;
        memory(log, process, head, size);
        if (text <= size - 4 && read_bytes(process, head + text, &value, 4) && value)
            string(log, process, value);
        if (!read_bytes(process, head + link, &head, 4)) return;
    }
    if (head) fprintf(log, "memory-graph-unbounded\n");
}

/* These are caller-side API observations, not reconstructed dependency code.
 * Preserve opaque object identity/vptr only; never inspect its private fields. */
static void widen_state(FILE *log, HANDLE process, CONTEXT *context, DWORD site)
{
    DWORD args[4], object, table, length, description[4];
    unsigned short record_length;
    if (site == 0x41029c) {
        if (!read_bytes(process, context->Esp, args, 12)) return;
        widen_output = args[0];
        fprintf(log, "widen create-call %08lx %lu %lu\n", args[0], args[1], args[2]);
    } else if (site == 0x4102a2) {
        if (!read_bytes(process, widen_output, &object, 4) || !read_bytes(process, object, &table, 4)) return;
        fprintf(log, "widen create-return %lu %08lx %08lx\n", context->Eax, object, table);
        memory(log, process, object, 4);
        memory(log, process, table, 40);
    } else if (site == 0x4102d5 || site == 0x4102f7 || site == 0x41031a) {
        widen_object = context->Ecx;
        length = site == 0x4102d5 ? 12 : 16;
        if (!read_bytes(process, context->Esp, widen_arguments, length)) return;
        fprintf(log, "widen method-call %u %08lx %08lx %08lx %08lx %08lx\n",
                site == 0x4102d5 ? 12 : site == 0x4102f7 ? 32 : 36,
                widen_object, widen_arguments[0], widen_arguments[1], widen_arguments[2],
                site == 0x4102d5 ? 0 : widen_arguments[3]);
        if (site == 0x4102d5) {
            if (!read_bytes(process, widen_arguments[1], &record_length, 2)) return;
            memory(log, process, widen_arguments[1], (DWORD)record_length + 2);
            memory(log, process, widen_arguments[2], 4);
        } else {
            memory(log, process, widen_arguments[1], widen_arguments[2]);
            memory(log, process, widen_arguments[0], 16);
            if (site == 0x41031a && read_bytes(process, widen_arguments[0], description, 16)) {
                widen_capacities[0] = description[0];
                widen_capacities[1] = description[1];
                memory(log, process, description[2], description[0]);
                memory(log, process, description[3], description[1] * 8);
            }
        }
    } else if (site == 0x4102d8 || site == 0x4102fa || site == 0x41031d) {
        fprintf(log, "widen method-return %u %08lx %lu\n",
                site == 0x4102d8 ? 12 : site == 0x4102fa ? 32 : 36, widen_object, context->Eax);
        if (site == 0x4102d8) {
            if (!read_bytes(process, widen_arguments[2], &length, 4)) return;
            memory(log, process, widen_arguments[2], 4);
            memory(log, process, widen_arguments[0], length);
        } else {
            memory(log, process, widen_arguments[0], 16);
            if (site == 0x41031d && read_bytes(process, widen_arguments[0], description, 16)) {
                memory(log, process, widen_arguments[1], widen_arguments[2]);
                memory(log, process, description[2], widen_capacities[0]);
                memory(log, process, description[3], widen_capacities[1] * 8);
            }
        }
    } else if (site == 0x4102b6) {
        fprintf(log, "widen destroy %08lx\n", context->Ecx);
    }
}

static void state(FILE *log, HANDLE process, CONTEXT *context, DWORD entry)
{
    DWORD i, j, value, count, item;
    fprintf(log, "registers %08lx %08lx %08lx %08lx %08lx %08lx %08lx %08lx\n",
            context->Eax, context->Ebx, context->Ecx, context->Edx,
            context->Esi, context->Edi, context->Ebp, context->Esp);
    memory(log, process, context->Esp, 128);
    memory(log, process, 0x412124, 28);
    memory(log, process, 0x412988, 12);
    memory(log, process, 0x412588, 1024);
    /* NT i386 TEB.LastErrorValue; TEB is supplied by the debug event, not
     * guessed from a target allocation or read from the debugger's thread. */
    if (active_teb && read_bytes(process, active_teb + 0x34, &value, 4))
        fprintf(log, "last-error %lu\n", value);
    for (i = 0; i < watch_count; ++i) memory(log, process, watched_address[i], watched_size[i]);
    for (i = 0; i < graph_count; ++i) {
        if (!read_bytes(process, graph_address[i], &value, 4)) continue;
        if (!graph_count_address[i]) linked_memory(log, process, value, graph_size[i], graph_link[i], graph_string[i]);
        else if (read_bytes(process, graph_count_address[i], &count, 4) && count <= 128) {
            memory(log, process, value, count * 4);
            for (j = 0; j < count; ++j) if (read_bytes(process, value + j * 4, &item, 4))
                linked_memory(log, process, item, graph_size[i], graph_link[i], graph_string[i]);
        }
    }
    for (i = 0; i < argument_count; ++i) if (argument_entry[i] == entry) {
        if (!read_bytes(process, context->Esp + argument_slot[i] * 4, &value, 4)) continue;
        if (argument_kind[i] == 'S' && value) string(log, process, value);
        if (argument_kind[i] == 'P' && value) memory(log, process, value, 4);
        if (argument_kind[i] == 'A' && value) {
            if (!read_bytes(process, context->Esp + (argument_slot[i]-1)*4, &count, 4) || count > 64) continue;
            memory(log, process, value, (count+1)*4);
            for (j = 0; j < count; ++j) if (read_bytes(process, value+j*4, &item, 4) && item) string(log, process, item);
        }
    }
    widen_state(log, process, context, entry);
}

static int module(FILE *log, HANDLE process, LOAD_DLL_DEBUG_INFO *info, const char *provider)
{
    IMAGE_DOS_HEADER dos;
    IMAGE_NT_HEADERS nt;
    IMAGE_EXPORT_DIRECTORY exports;
    DWORD base, name_address, bytes, total;
    char name[128];
    unsigned char block[4096];
    HANDLE output;
    base = (DWORD)info->lpBaseOfDll;
    if (!read_bytes(process, base, &dos, sizeof(dos)) || dos.e_magic != IMAGE_DOS_SIGNATURE ||
        !read_bytes(process, base + dos.e_lfanew, &nt, sizeof(nt)) ||
        nt.Signature != IMAGE_NT_SIGNATURE) return 0;
    name[0] = 0;
    if (nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress) {
        if (!read_bytes(process, base + nt.OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT].VirtualAddress,
                        &exports, sizeof(exports))) return 0;
        name_address = base + exports.Name;
        if (!read_bytes(process, name_address, name, sizeof(name))) return 0;
        name[sizeof(name)-1] = 0;
    }
    fprintf(log, "module %08lx %s\n", base, name);
    if (_stricmp(name, "MSVCRT.dll")) {
        if (_stricmp(name, "mspdb50.dll") || !getenv("VC510_CVPACK_PDB_PROVIDER")) return 1;
        provider = getenv("VC510_CVPACK_PDB_PROVIDER");
    }
    if (!info->hFile || info->hFile == INVALID_HANDLE_VALUE) return 0;
    if (SetFilePointer(info->hFile, 0, NULL, FILE_BEGIN) == 0xffffffffUL && GetLastError()) return 0;
    output = CreateFileA(provider, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (output == INVALID_HANDLE_VALUE) return 0;
    total = 0;
    for (;;) {
        if (!ReadFile(info->hFile, block, sizeof(block), &bytes, NULL)) { CloseHandle(output); return 0; }
        if (!bytes) break;
        if (!WriteFile(output, block, bytes, &name_address, NULL) || name_address != bytes) {
            CloseHandle(output); return 0;
        }
        total += bytes;
    }
    CloseHandle(output);
    fprintf(log, "provider-bytes %lu\n", total);
    return 1;
}

int main(int argc, char **argv)
{
    SECURITY_ATTRIBUTES security;
    STARTUPINFOA startup;
    PROCESS_INFORMATION child;
    DEBUG_EVENT event;
    CONTEXT context;
    HANDLE stdout_file, stderr_file, thread;
    HANDLE threads[64];
    DWORD thread_tebs[64];
    DWORD thread_ids[64], thread_count = 0;
    FILE *log, *plan, *original;
    DWORD address, disposition, entry, i, status, count;
    unsigned char trap = 0xcc;
    int initial_break = 1, done = 0, failed = 0, known;
    char command[2048];
    if (argc != 11) return 90;
    configure();
    log = fopen(argv[5], "wb");
    plan = fopen(argv[7], "r");
    original = fopen(argv[8], "rb");
    if (!log || !plan || !original) return 91;
    while (range_count < 256 && fscanf(plan, "%lx %lx %lx", &ranges[range_count].start,
            &ranges[range_count].end, &ranges[range_count].offset) == 3) ++range_count;
    fclose(plan);
    probes_enabled = atoi(argv[10]) || probe_count > 6;
    memset(&security, 0, sizeof(security));
    security.nLength = sizeof(security);
    security.bInheritHandle = TRUE;
    stdout_file = CreateFileA(argv[3], GENERIC_WRITE, FILE_SHARE_READ, &security, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    stderr_file = CreateFileA(argv[4], GENERIC_WRITE, FILE_SHARE_READ, &security, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL);
    if (stdout_file == INVALID_HANDLE_VALUE || stderr_file == INVALID_HANDLE_VALUE) return 92;
    memset(&startup, 0, sizeof(startup));
    startup.cb = sizeof(startup);
    startup.dwFlags = STARTF_USESTDHANDLES;
    startup.hStdInput = GetStdHandle(STD_INPUT_HANDLE);
    startup.hStdOutput = stdout_file;
    startup.hStdError = stderr_file;
    strcpy(command, argv[2]);
    if (!CreateProcessA(argv[1], command, NULL, NULL, TRUE, DEBUG_ONLY_THIS_PROCESS,
                        NULL, argv[6], &startup, &child)) return 93;
    while (!done && WaitForDebugEvent(&event, 30000)) {
        disposition = DBG_CONTINUE;
        if (event.dwDebugEventCode == CREATE_PROCESS_DEBUG_EVENT) {
            threads[thread_count] = event.u.CreateProcessInfo.hThread;
            thread_tebs[thread_count] = (DWORD)event.u.CreateProcessInfo.lpThreadLocalBase;
            thread_ids[thread_count++] = event.dwThreadId;
            entry = (DWORD)event.u.CreateProcessInfo.lpStartAddress;
            fprintf(log, "process-base %08lx entry %08lx\n", (DWORD)event.u.CreateProcessInfo.lpBaseOfImage, entry);
            if ((DWORD)event.u.CreateProcessInfo.lpBaseOfImage != 0x400000 || entry != 0x410330) failed = 1;
            if (event.u.CreateProcessInfo.hFile) CloseHandle(event.u.CreateProcessInfo.hFile);
        } else if (event.dwDebugEventCode == CREATE_THREAD_DEBUG_EVENT) {
            if (thread_count == 64) failed = 1;
            else {
                threads[thread_count] = event.u.CreateThread.hThread;
                thread_tebs[thread_count] = (DWORD)event.u.CreateThread.lpThreadLocalBase;
                thread_ids[thread_count++] = event.dwThreadId;
            }
        } else if (event.dwDebugEventCode == LOAD_DLL_DEBUG_EVENT) {
            if (!module(log, child.hProcess, &event.u.LoadDll, argv[9])) failed = 1;
            if (event.u.LoadDll.hFile) CloseHandle(event.u.LoadDll.hFile);
        } else if (event.dwDebugEventCode == EXCEPTION_DEBUG_EVENT) {
            address = (DWORD)event.u.Exception.ExceptionRecord.ExceptionAddress;
            status = event.u.Exception.ExceptionRecord.ExceptionCode;
            thread = NULL;
            for (i = 0; i < thread_count; ++i) if (thread_ids[i] == event.dwThreadId) {
                thread = threads[i]; active_teb = thread_tebs[i];
            }
            memset(&context, 0, sizeof(context));
            context.ContextFlags = CONTEXT_FULL;
            if (!thread || !GetThreadContext(thread, &context)) return 94;
            if (status == EXCEPTION_SINGLE_STEP && pending_probe >= 0) {
                context.EFlags &= ~0x100;
                if (!write_bytes(child.hProcess, probe_sites[pending_probe], &trap, 1)) failed = 1;
                pending_probe = -1;
                SetThreadContext(thread, &context);
            } else if (status == EXCEPTION_BREAKPOINT) {
                if (initial_break && (address < 0x401000 || address >= 0x4104c6)) {
                    initial_break = 0;
                    if (probes_enabled) for (i = 0; i < probe_count; ++i) {
                        if (!read_bytes(child.hProcess, probe_sites[i], &probe_bytes[i], 1) ||
                            !write_bytes(child.hProcess, probe_sites[i], &trap, 1)) failed = 1;
                    }
                } else {
                    known = 0;
                    for (i = 0; probes_enabled && i < probe_count; ++i) if (address == probe_sites[i]) {
                        fprintf(log, "%s %08lx eax %08lx\n", probe_names[i], address, context.Eax);
                        state(log, child.hProcess, &context, address);
                        if (!write_bytes(child.hProcess, address, &probe_bytes[i], 1)) failed = 1;
                        context.Eip = address;
                        context.EFlags |= 0x100;
                        pending_probe = i;
                        SetThreadContext(thread, &context);
                        known = 1;
                    }
                    for (i = 0; !known && i < range_count; ++i) if (ranges[i].start == address && !ranges[i].reached) {
                        count = ranges[i].end - address;
                        if (!count || count > sizeof(original_bytes) ||
                            fseek(original, ranges[i].offset, SEEK_SET) ||
                            fread(original_bytes, 1, count, original) != count ||
                            !write_bytes(child.hProcess, address, original_bytes, count)) failed = 1;
                        ranges[i].reached = 1;
                        fprintf(log, "entry %08lx\n", address);
                        state(log, child.hProcess, &context, address);
                        context.Eip = address;
                        SetThreadContext(thread, &context);
                        known = 1;
                    }
                    if (!known) {
                        fprintf(log, "frontier %08lx\n", address);
                        state(log, child.hProcess, &context, address);
                        TerminateProcess(child.hProcess, 125);
                        done = 1;
                    }
                }
            } else {
                fprintf(log, "exception %08lx %08lx first %lu\n", status, address, event.u.Exception.dwFirstChance);
                state(log, child.hProcess, &context, address);
                TerminateProcess(child.hProcess, 126);
                failed = 1;
                done = 1;
            }
        } else if (event.dwDebugEventCode == EXIT_PROCESS_DEBUG_EVENT) {
            fprintf(log, "exit %lu\n", event.u.ExitProcess.dwExitCode);
            done = 1;
        }
        if (failed) { TerminateProcess(child.hProcess, 127); done = 1; }
        if (!ContinueDebugEvent(event.dwProcessId, event.dwThreadId, disposition)) failed = 1;
        fflush(log);
    }
    if (!done) { fprintf(log, "debug-timeout\n"); TerminateProcess(child.hProcess, 124); failed = 1; }
    WaitForSingleObject(child.hProcess, 10000);
    CloseHandle(child.hProcess);
    CloseHandle(child.hThread);
    CloseHandle(stdout_file);
    CloseHandle(stderr_file);
    fclose(original);
    fclose(log);
    return failed ? 95 : 0;
}
