/* Type-packing tables and their original initialization [0040aff0,0040b13d). */
#include "types.h"
#include <recon.h>

unsigned char *type_table_primary, *type_table_primary_counts;
unsigned char *type_table_secondary, *type_table_secondary_counts;
unsigned char *type_table_local, *type_table_global;
unsigned char *type_table_forward, *type_table_pending;
unsigned char *type_hash_buckets, *type_references, *type_positions;
unsigned short type_table_limit;
unsigned type_table_used;
TypeArena type_arena, type_large_arena;
TypeRecord *empty_type_record;

void initialize_type_tables(void)
{
    type_table_primary = allocate_cleared(0x4000);
    type_table_primary_counts = allocate_cleared(0x2000);
    type_table_secondary = allocate_cleared(0x4000);
    type_table_secondary_counts = allocate_cleared(0x2000);
    type_table_local = allocate_cleared(0x4000);
    type_table_global = allocate_cleared(0x4000);
    type_table_forward = allocate_cleared(0x4000);
    type_table_pending = allocate_cleared(0x4000);
    type_hash_buckets = allocate_cleared(0x600);
    type_references = allocate_cleared(0x800);
    type_positions = allocate_cleared(0x800);
    type_table_limit = 128;
    type_table_used = 0;
    initialize_arena(&type_arena, 0x1000);
    initialize_arena(&type_large_arena, 0x10000);
    empty_type_record = allocate_cleared(sizeof(TypeRecord));
    empty_type_record->data = allocate_bytes(8);
    empty_type_record->flags |= 4;
    *(unsigned short *)empty_type_record->data = 8;
    *(unsigned short *)(empty_type_record->data + 2) = 0x1201;
    *(unsigned *)(empty_type_record->data + 4) = 0;
}

/* Original checked allocation with explicit clearing [0040fb90,0040fbce). */
void *allocate_cleared(unsigned size)
{
    unsigned char *result = malloc(size);
    unsigned index;
    if (!result) fatal_error(1001, NULL, NULL);
    for (index = 0; index < size; ++index) result[index] = 0;
    return result;
}

/* Original arena initialization [0040ff60,0040ff78). */
void initialize_arena(TypeArena *arena, unsigned capacity)
{
    unsigned index;
    arena->capacity = 0;
    for (index = 0; index < 5; ++index) arena->fields[index] = 0;
    arena->capacity = capacity;
}
