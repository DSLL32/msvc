/* Encountered unsupported-option and missing-intermediate diagnostics. */
LANGUAGE 9, 1
STRINGTABLE
BEGIN
    301 "warning"
    302 "error"
    303 "fatal error"
    310 "compiler generated"
    311 "compiler intermediate"
    312 "source"
    1007 "unrecognized flag '%s' in '%s'"
    1083 "Cannot open %Fs file: '%Fs': %Fs"
END
