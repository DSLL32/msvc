IDR_MENU MENU MOVEABLE PURE
BEGIN
POPUP "&File"
BEGIN
MENUITEM "&Open\tCtrl+O", IDM_OPEN
MENUITEM SEPARATOR
MENUITEM "E&xit", IDM_EXIT
END
POPUP "&Options"
BEGIN
MENUITEM "&Checked", IDM_CHECKED, CHECKED
MENUITEM "Unavailable", 204, GRAYED
POPUP "Nested"
BEGIN
MENUITEM "Nested command", 205
END
END
END
