IDD_MAIN DIALOG DISCARDABLE 0, 0, 220, 170
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION APP_TITLE
FONT 8, "MS Sans Serif"
MENU IDR_MENU
BEGIN
LTEXT "Name:", -1, 8, 8, 35, 10
EDITTEXT IDC_EDIT, 45, 6, 100, 14, ES_AUTOHSCROLL
GROUPBOX "Choices", IDC_GROUP, 6, 26, 140, 50
AUTOCHECKBOX "Enabled", IDC_CHECK, 12, 38, 60, 12
AUTORADIOBUTTON "First", IDC_RADIO, 78, 38, 60, 12, WS_GROUP
LISTBOX IDC_LIST, 8, 82, 100, 40, LBS_SORT | WS_VSCROLL
COMBOBOX IDC_COMBO, 114, 82, 98, 50, CBS_DROPDOWNLIST | WS_VSCROLL
SCROLLBAR IDC_SCROLL, 8, 128, 100, 10, SBS_HORZ
CONTROL "Generic", IDC_GENERIC, "STATIC", SS_CENTER | WS_BORDER, 114, 128, 98, 12
ICON IDI_MAIN, -1, 166, 8, 20, 20
DEFPUSHBUTTON "OK", IDOK, 104, 150, 50, 14
PUSHBUTTON "Cancel", IDCANCEL, 160, 150, 50, 14
END
