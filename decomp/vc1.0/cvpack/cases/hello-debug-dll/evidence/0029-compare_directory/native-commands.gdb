 owner=current.older()
 while owner and owner.name()!=proof["owner"]: owner=owner.older()
 if not owner: raise RuntimeError("missing output owner")
 local=owner.read_var(proof["local"]); address=int(local.address); argument=parameters[description["name"]]
 if argument["address"]!=address+proof["offset"] or local.type.sizeof!=proof["size"]: raise RuntimeError("wrong output local")
 argument["local_address"]=address
 argument["local"]=dict(owner=owner.name(),name=proof["local"],size=int(local.type.sizeof),offset=proof["offset"])
 argument["prebytes"]=bytes(gdb.selected_inferior().read_memory(argument["address"],proof["size"])).hex()
frames=[]
