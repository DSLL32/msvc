set args /nologo /cvnew hello-debug.dll
break main
run /nologo /cvnew hello-debug.dll > /root/.ai-tmp/vc1.0-cvpack/0143-native/hello-debug-dll/debug-stdout 2> /root/.ai-tmp/vc1.0-cvpack/0143-native/hello-debug-dll/debug-stderr
