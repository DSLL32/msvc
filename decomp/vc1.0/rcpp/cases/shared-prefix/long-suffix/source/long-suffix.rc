#define LONG_ONE 1L
#define LONG_VALUE(x) (x)
#if 0L
long_zero_nonzero
#else
long_zero_ok
#endif
#if (LONG_ONE + 2l) == 3L
long_add_ok
#else
long_add_false
#endif
#if 0x7fffffffL > 1L
long_max_positive
#else
long_max_not_positive
#endif
#if LONG_VALUE(0x80000000L) < 0L
long_high_bit_negative
#else
long_high_bit_nonnegative
#endif
#if 0xffffffffL == -1L
long_all_bits_minus_one
#else
long_all_bits_other
#endif
#if (0xfffffffeL & 0xffL) == 254L
long_mask_ok
#else
long_mask_false
#endif
#if (1L << 4L) == 16L
long_shift_ok
#else
long_shift_false
#endif
