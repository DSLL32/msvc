{
  "status": "Original-validated proposals; not queued for reconstruction.",
  "toolchain": "1.0-nt",
  "cases": [
    {
      "name": "hello-debug-dll",
      "arguments": [
        "-link",
        "@debug-link.rsp"
      ],
      "environment": {
        "LIB": "{toolchain}/lib"
      },
      "inputs": [
        "hello-debug.obj",
        "helpers.lib",
        "resources.res",
        "hello-debug.def",
        "order.txt"
      ],
      "outputs": [
        "hello-debug.dll",
        "hello-debug.lib",
        "hello-debug.exp",
        "hello-debug.map"
      ],
      "targets": [
        "debug COFF/CodeView/FPO and CVPACK launch",
        "map symbol sorting/undecoration",
        "order file and code reordering",
        "definition file aliases/ordinals/NONAME/forwarder/DATA",
        "resource conversion",
        "C++ COMDAT selection",
        "library exclusion",
        "image checksum"
      ]
    },
    {
      "name": "archive-dump-edit",
      "environment": {
        "LIB": "{toolchain}/lib",
        "LINK32_DB": "27"
      },
      "setup": "Copy hello-debug.dll to edited.dll before edit; alpha.obj to member-with-a-long-name-alpha.obj before archive creation.",
      "commands": [
        [
          "-lib",
          "/out:helpers.lib",
          "member-with-a-long-name-alpha.obj",
          "beta.obj"
        ],
        [
          "-lib",
          "/list",
          "helpers.lib"
        ],
        [
          "-lib",
          "/extract:member-with-a-long-name-alpha.obj",
          "helpers.lib"
        ],
        [
          "-lib",
          "/remove:beta.obj",
          "/out:trimmed.lib",
          "helpers.lib"
        ],
        [
          "-lib",
          "/list",
          "trimmed.lib"
        ],
        [
          "-dump",
          "/all",
          "helpers.lib"
        ],
        [
          "-dump",
          "/all",
          "member-with-a-long-name-alpha.obj"
        ],
        [
          "-dump",
          "/all",
          "hello-debug.dll"
        ],
        [
          "-edit",
          "/stack:0x180000,0x2000",
          "/heap:0x140000,0x2000",
          "/release",
          "edited.dll"
        ],
        [
          "-dump",
          "/headers",
          "edited.dll"
        ]
      ],
      "targets": [
        "buffered file backend",
        "ordinary archive writer and long names",
        "member listing/extraction/removal",
        "dumper object/archive/PE header, symbol, relocation, debug/resource modes",
        "editor stack/heap changes and checksum warning"
      ]
    }
  ]
}
