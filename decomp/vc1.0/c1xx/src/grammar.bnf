expression : expression RELATIONAL_OPERATOR expression ; # rule 278, expression[12]
expression : expression SHIFT_OPERATOR expression ; # rule 279, expression[13]
expression : expression PLUS expression ; # rule 280, expression[14]
expression : expression MINUS expression ; # rule 281, expression[15]
expression : expression STAR expression ; # rule 282, expression[16]
expression : expression DIVISION_OPERATOR expression ; # rule 283, expression[17]
