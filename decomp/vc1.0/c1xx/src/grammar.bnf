statement : FOR LPAREN for_scope_begin for_initializer for_condition_begin optional_expression SEMICOLON for_increment_begin optional_expression for_closing_semicolon_opt RPAREN for_body_begin labeled_statement ; # rule 208, statement[7]
do_body_begin :  ; # rule 209, do_body_begin[1]
do_condition_begin :  ; # rule 210, do_condition_begin[1]
statement : DO do_body_begin labeled_statement WHILE LPAREN do_condition_begin expression RPAREN SEMICOLON ; # rule 211, statement[8]
switch_condition_begin :  ; # rule 212, switch_condition_begin[1]
switch_body_begin :  ; # rule 213, switch_body_begin[1]
statement : SWITCH LPAREN switch_condition_begin expression RPAREN switch_body_begin labeled_statement ; # rule 214, statement[9]
statement : SEH_LEAVE SEMICOLON ; # rule 215, statement[10]
statement : BREAK SEMICOLON ; # rule 216, statement[11]
statement : CONTINUE SEMICOLON ; # rule 217, statement[12]
statement : RETURN SEMICOLON ; # rule 218, statement[13]
return_expression_begin :  ; # rule 219, return_expression_begin[1]
statement : RETURN return_expression_begin expression SEMICOLON ; # rule 220, statement[14]
statement : GOTO IDENTIFIER SEMICOLON ; # rule 221, statement[15]
statement : ASM_BLOCK ; # rule 222, statement[16]
statement : seh_except_head compound_statement ; # rule 223, statement[17]
seh_finally_begin :  ; # rule 224, seh_finally_begin[1]
