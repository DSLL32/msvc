expression_id : conversion_function_id ; # rule 321, expression_id[3]
expression_id : QUALIFIED_ID ; # rule 322, expression_id[4]
expression_id : QUALIFIED_ID conversion_function_id ; # rule 323, expression_id[5]
expression_id : SIMPLE_TYPE_CALL ; # rule 324, expression_id[6]
type_cast : LPAREN declaration_specifiers abstract_declarator RPAREN ; # rule 325, type_cast[1]
call_arguments : LPAREN argument_list RPAREN ; # rule 326, call_arguments[1]
call_arguments : LPAREN RPAREN ; # rule 327, call_arguments[2]
argument_list : expression %prec COMMA ; # rule 328, argument_list[1]
argument_list : argument_list COMMA expression ; # rule 329, argument_list[2]
