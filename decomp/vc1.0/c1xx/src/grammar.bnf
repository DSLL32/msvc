unary_expression : postfix_expression ; # rule 289, unary_expression[1]
unary_expression : INCREMENT_OPERATOR unary_expression ; # rule 290, unary_expression[2]
unary_expression : STAR cast_expression ; # rule 291, unary_expression[3]
unary_expression : AMPERSAND cast_expression ; # rule 292, unary_expression[4]
unary_expression : PLUS cast_expression ; # rule 293, unary_expression[5]
unary_expression : MINUS cast_expression ; # rule 294, unary_expression[6]
unary_expression : NOT cast_expression ; # rule 295, unary_expression[7]
complement_operand_begin :  ; # rule 296, complement_operand_begin[1]
unary_expression : TILDE complement_operand_begin cast_expression ; # rule 297, unary_expression[8]
unary_expression : SIZEOF cast_expression ; # rule 298, unary_expression[9]
unary_expression : SIZEOF type_cast ; # rule 299, unary_expression[10]
unary_expression : ALIGNOF type_cast ; # rule 300, unary_expression[11]
unary_expression : completed_new_expression ; # rule 301, unary_expression[12]
unary_expression : delete_expression ; # rule 302, unary_expression[13]
postfix_expression : primary_expression ; # rule 303, postfix_expression[1]
