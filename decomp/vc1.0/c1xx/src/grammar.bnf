initializer_trailing_separator_opt : SEMICOLON ; # rule 356, initializer_trailing_separator_opt[3]

# Recovery inserts are expressed by production/dot contexts, not state numbers.
# A leading ! excludes an item; deferred suppresses an immediate repeat diagnostic.
%recover $accept@1 SEMICOLON deferred
%recover external_declaration[1]@1 SEMICOLON deferred
%recover external_declaration[4]@1 SEMICOLON
%recover external_declaration[5]@1 SEMICOLON
%recover declaration[1]@1 SEMICOLON
%recover declaration[3]@1 SEMICOLON
%recover declaration[4]@1 COLON deferred
%recover linkage_specification[1]@1 SEMICOLON deferred
%recover class_specifier[1]@1 COLON deferred
%recover parenthesized_initializer[1]@1,parameter_clause[1]@1 RPAREN deferred
%recover declaration[5]@2 SEMICOLON
%recover declarator[7]@2 RPAREN deferred
%recover parenthesized_initializer[1]@2 RPAREN deferred
%recover parameter_clause[1]@1,!parenthesized_abstract_declarator[1]@1,!parenthesized_initializer[1]@1 RPAREN deferred
%recover primary_expression[4]@2 RPAREN deferred
%recover call_arguments[1]@1 RPAREN deferred
%recover linkage_specification[1]@3 SEMICOLON deferred
%recover asm_definition[1]@3 RPAREN deferred
%recover parameter_clause[2]@3 COMMA deferred
%recover exception_specification[1]@1 RPAREN deferred
%recover constructor_initializer_opt[2]@3 SEMICOLON deferred
%recover mem_initializer[3]@1 RPAREN deferred
%recover postfix_expression[2]@3 RBRACKET deferred
%recover type_cast[1]@3 RPAREN deferred
%recover parenthesized_abstract_declarator[1]@1,!declarator[7]@1 RPAREN deferred
%recover call_arguments[1]@2 RPAREN deferred
%recover optional_expression[2]@1 COMMA deferred
%recover segment_name[1]@3 RPAREN deferred
%recover class_specifier[1]@4 SEMICOLON deferred
%recover class_specifier[2]@4 SEMICOLON deferred
%recover declarator[7]@1,parameter_clause[1]@1 RPAREN deferred
%recover catch_parameter_clause[1]@2 RPAREN deferred
%recover expression[5]@4 COMMA deferred
%recover new_initializer_opt[3]@1 RPAREN deferred
%recover member_declaration[2]@1 SEMICOLON deferred
%recover member_declaration[3]@1 SEMICOLON deferred
%recover member_declaration[8]@1 SEMICOLON deferred
%recover member_declarator[1]@1 COLON deferred
%recover parenthesized_new_type[1]@3 RPAREN deferred
%recover member_declaration[4]@2 SEMICOLON deferred
%recover member_declarator_list[2]@2 COLON deferred
%recover labeled_statement[1]@1 SEMICOLON deferred
%recover statement[1]@1 SEMICOLON deferred
%recover statement[10]@1 SEMICOLON
%recover statement[11]@1 SEMICOLON
%recover statement[12]@1 SEMICOLON
%recover statement[22]@1 SEMICOLON
%recover class_specifier[2]@8 SEMICOLON deferred
%recover statement[15]@2 SEMICOLON
%recover label[2]@2 COMMA deferred
%recover statement[7]@3 SEMICOLON deferred
%recover statement[14]@3 SEMICOLON deferred
%recover statement[6]@4 RPAREN deferred
%recover for_init_statement[1]@1 SEMICOLON deferred
%recover statement[9]@4 RPAREN deferred
%recover if_head[1]@4 RPAREN deferred
%recover seh_except_head[1]@5 RPAREN deferred
%recover statement[7]@6 SEMICOLON
