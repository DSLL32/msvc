handler : handler_head compound_statement ; # rule 234, handler[1]
handler_head : CATCH catch_parameter_clause ; # rule 235, handler_head[1]
exception_specification : LPAREN RPAREN ; # rule 236, exception_specification[1]
exception_specification : catch_parameter_clause ; # rule 237, exception_specification[2]
catch_parameter_clause : LPAREN parameter_list RPAREN ; # rule 238, catch_parameter_clause[1]
catch_parameter_clause : LPAREN ELLIPSIS RPAREN ; # rule 239, catch_parameter_clause[2]
seh_try_begin :  ; # rule 240, seh_try_begin[1]
seh_try_statement : SEH_TRY seh_try_begin compound_statement ; # rule 241, seh_try_statement[1]
seh_filter_begin :  ; # rule 242, seh_filter_begin[1]
