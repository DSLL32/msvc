statement : try_block ; # rule 226, statement[19]
statement : ELSE ; # rule 227, statement[20]
statement : SEMICOLON ; # rule 228, statement[21]
statement : ERROR SEMICOLON ; # rule 229, statement[22]
handlers_begin :  ; # rule 230, handlers_begin[1]
