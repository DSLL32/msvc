for_closing_semicolon_opt :  ; # rule 244, for_closing_semicolon_opt[1]
for_closing_semicolon_opt : SEMICOLON ; # rule 245, for_closing_semicolon_opt[2]
for_initializer : for_init_statement ; # rule 246, for_initializer[1]
for_init_statement : expression SEMICOLON ; # rule 247, for_init_statement[1]
for_init_statement : declaration ; # rule 248, for_init_statement[2]
for_init_statement : SEMICOLON ; # rule 249, for_init_statement[3]
label_seq_opt :  ; # rule 250, label_seq_opt[1]
label_seq_opt : label_seq_opt label ; # rule 251, label_seq_opt[2]
label : IDENTIFIER COLON ; # rule 252, label[1]
label : CASE expression COLON ; # rule 253, label[2]
label : DEFAULT COLON ; # rule 254, label[3]
if_condition_begin :  ; # rule 255, if_condition_begin[1]
if_head : IF LPAREN if_condition_begin expression RPAREN ; # rule 256, if_head[1]
else_head : if_head labeled_statement ELSE ; # rule 257, else_head[1]
array_bound_opt :  ; # rule 258, array_bound_opt[1]
array_bound_opt : constant_expression ; # rule 259, array_bound_opt[2]
constant_expression : expression %prec COMMA ; # rule 260, constant_expression[1]
optional_expression :  ; # rule 261, optional_expression[1]
optional_expression : expression ; # rule 262, optional_expression[2]
expression : expression COMMA expression ; # rule 263, expression[1]
expression : THROW expression ; # rule 264, expression[2]
expression : expression ASSIGN expression ; # rule 265, expression[3]
