string_literal_seq : STRING_LITERAL ; # rule 331, string_literal_seq[1]
string_literal_seq : string_literal_seq STRING_LITERAL ; # rule 332, string_literal_seq[2]
completed_new_expression : new_expression ; # rule 333, completed_new_expression[1]
new_expression : new_keyword type_modifiers_opt new_type new_initializer_opt ; # rule 334, new_expression[1]
new_expression : new_keyword type_modifiers_opt parenthesized_new_type new_initializer_opt ; # rule 335, new_expression[2]
new_expression : new_keyword type_modifiers_opt parenthesized_initializer new_type new_initializer_opt ; # rule 336, new_expression[3]
new_expression : new_keyword type_modifiers_opt parenthesized_initializer parenthesized_new_type new_initializer_opt ; # rule 337, new_expression[4]
new_keyword : NEW ; # rule 338, new_keyword[1]
new_type : declaration_specifiers new_declarator_opt ; # rule 339, new_type[1]
