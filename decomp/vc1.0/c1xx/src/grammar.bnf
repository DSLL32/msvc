postfix_expression : postfix_expression INCREMENT_OPERATOR ; # rule 309, postfix_expression[5]
postfix_expression : OPERATOR call_arguments ; # rule 310, postfix_expression[6]
primary_expression : CONSTANT ; # rule 311, primary_expression[1]
primary_expression : string_literal_seq ; # rule 312, primary_expression[2]
primary_expression : THIS ; # rule 313, primary_expression[3]
