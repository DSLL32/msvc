diff --git a/decomp/vc1.0/c1xx/src/function-finalization.c b/decomp/vc1.0/c1xx/src/function-finalization.c
index 828e0a839..2c4f73e9f 100644
--- a/decomp/vc1.0/c1xx/src/function-finalization.c
+++ b/decomp/vc1.0/c1xx/src/function-finalization.c
@@ -531,3 +531,24 @@ void __stdcall begin_initializer_function(CppSymbol *symbol)
     function_symbol->declaration_flags =
         (function_symbol->declaration_flags & ~0x100) | 0x200;
 }
+
+/* Original 0x9ebd0. The closing routine brackets finish_function_body
+   with this DWORD. No direct reader has been identified in the image. */
+int initializer_function_closing;
+
+/* Original 0x48560..0x485c6, stdcall4. Close the two synthetic
+   body scopes, optionally retain the function, then leave capture mode. */
+void __stdcall flush_current_function(int retain)
+{
+    if (function_symbol) {
+        declaration_mode = 2;
+        leave_compound_scope();
+        initializer_function_closing = 1;
+        finish_function_body(1);
+        initializer_function_closing = 0;
+        if (retain) append_vector(translation_symbols, function_symbol);
+    }
+    function_symbol = 0;
+    token_allocation_flags &= ~0x80000;
+    token_allocation_flags &= ~0x40;
+}
