{
  "description": "Candidate cases for the unreconstructed remainder of CL; original-only entry tracing, not accepted reconstruction cases.",
  "cases": [
    {
      "id": "usage",
      "arguments": "",
      "targets": [
        "_usage"
      ],
      "purpose": "No-argument usage and early exit",
      "expected_exit": 0
    },
    {
      "id": "missing-input",
      "arguments": "/nologo",
      "targets": [
        "_fatal"
      ],
      "purpose": "Fatal no-input diagnostic",
      "expected_exit": 2
    },
    {
      "id": "invalid-number",
      "arguments": "/W5 /c test.c",
      "targets": [
        "_warning"
      ],
      "purpose": "Range validation warns and substitutes the default value",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "missing-option-value",
      "arguments": "/Tc",
      "targets": [
        "_option_callback_1920c",
        "_fatal"
      ],
      "purpose": "Missing argument after explicit file-type option",
      "expected_exit": 2
    },
    {
      "id": "unknown-option",
      "arguments": "/not_a_switch /c test.c",
      "targets": [
        "_warning"
      ],
      "purpose": "Unknown-option warning followed by successful compilation",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "conflicting-options",
      "arguments": "/O1 /O2 /c test.c",
      "targets": [
        "_warn_override",
        "_warning"
      ],
      "purpose": "User optimization options override one another",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "override-side-effects",
      "arguments": "/Ge /O2 /c test.c",
      "targets": [
        "_copy_item"
      ],
      "purpose": "Remove an earlier user option and its derived options",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "incompatible-options",
      "arguments": "/Za /Ze /c test.c",
      "targets": [
        "_warn_override",
        "_fatal"
      ],
      "purpose": "Conflicting required language modes",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 2
    },
    {
      "id": "nested-response",
      "arguments": "@outer.rsp",
      "targets": [
        "_read_response_file"
      ],
      "purpose": "Nested response files, whitespace and quoted source/output names",
      "files": {
        "space name.c": "../test.c"
      },
      "text_files": {
        "outer.rsp": "/nologo @inner.rsp\r\n",
        "inner.rsp": "/c /DVALUE#42 /Fo\"space output.obj\" \"space name.c\"\r\n"
      },
      "expected_exit": 0
    },
    {
      "id": "missing-response",
      "arguments": "@absent.rsp",
      "targets": [
        "_read_response_file",
        "_fatal"
      ],
      "purpose": "Response-file open failure",
      "expected_exit": 2
    },
    {
      "id": "response-cycle",
      "arguments": "@loop.rsp",
      "targets": [
        "_read_response_file",
        "_fatal"
      ],
      "purpose": "Response-file recursion limit (14 nested reads is fatal)",
      "text_files": {
        "loop.rsp": "@loop.rsp\r\n"
      },
      "expected_exit": 2
    },
    {
      "id": "link-tail",
      "arguments": "test.c /link /nologo /subsystem:console",
      "targets": [
        "_option_callback_19014"
      ],
      "purpose": "Forward every argument after /link to the linker",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "link-attached",
      "arguments": "test.c /link/subsystem:console /nologo",
      "targets": [
        "_option_callback_19014"
      ],
      "purpose": "Attached first linker option plus remaining tokens",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "force-c",
      "arguments": "/c /Tcforced.src",
      "targets": [
        "_option_callback_1920c"
      ],
      "purpose": "Compile a nonstandard suffix as C",
      "files": {
        "forced.src": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "force-cpp",
      "arguments": "/c /Tp cplusplus.src",
      "targets": [
        "_option_callback_19228"
      ],
      "purpose": "Force C++ with a separate filename argument",
      "files": {
        "cplusplus.src": "cplusplus.src"
      },
      "expected_exit": 0
    },
    {
      "id": "force-object",
      "arguments": "/To object.blob /Feobject.exe",
      "targets": [
        "_option_callback_19198"
      ],
      "purpose": "Link a supplied object with a nonstandard suffix",
      "files": {
        "object.blob": "../../../fixtures/minimal-c/link/test.obj"
      },
      "expected_exit": 0
    },
    {
      "id": "undefine-predefines",
      "arguments": "/u /c test.c",
      "targets": [
        "_driver_switch_170a0"
      ],
      "purpose": "Remove default preprocessor definitions",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "preprocess-stdout",
      "arguments": "/E /I\"include dir\" preprocess.c",
      "targets": [
        "_driver_switch_17368"
      ],
      "purpose": "Enable only frontend and preprocess to stdout",
      "files": {
        "preprocess.c": "preprocess.c",
        "include dir/settings.h": "settings.h"
      },
      "expected_exit": 0
    },
    {
      "id": "preprocess-file",
      "arguments": "/P /I\"include dir\" preprocess.c",
      "targets": [
        "_driver_switch_17368"
      ],
      "purpose": "Preprocess to a file",
      "files": {
        "preprocess.c": "preprocess.c",
        "include dir/settings.h": "settings.h"
      },
      "expected_exit": 0
    },
    {
      "id": "prototype-only",
      "arguments": "/Zg test.c",
      "targets": [
        "_driver_switch_17368"
      ],
      "purpose": "Emit declarations without backend or linker",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "syntax-only",
      "arguments": "/Zs test.c",
      "targets": [
        "_driver_switch_17368"
      ],
      "purpose": "Run only syntax checking",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "assembly-listing",
      "arguments": "/FAsc /c test.c",
      "targets": [
        "_driver_switch_173ac"
      ],
      "purpose": "Assembly/source/machine-code listing configuration",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "required-option-present",
      "arguments": "/C /E test.c",
      "targets": [
        "_any_match"
      ],
      "purpose": "Comment preservation has its preprocessing prerequisite",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "required-option-missing",
      "arguments": "/C /c test.c",
      "targets": [
        "_any_match",
        "_warning"
      ],
      "purpose": "Missing prerequisite removes option and warns",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "map-and-renamed-output",
      "arguments": "/Fm\"output dir/custom.map\" /Fe\"output dir/custom.exe\" test.c",
      "targets": [
        "_map_filename"
      ],
      "purpose": "Derived map filename and quoted output paths",
      "files": {
        "test.c": "../test.c"
      },
      "text_files": {
        "output dir/.keep": ""
      },
      "expected_exit": 0
    },
    {
      "id": "dll-output",
      "arguments": "/LD /Fedemo.dll dll.c",
      "targets": [
        "_driver_switch_17010",
        "_output_stem"
      ],
      "purpose": "DLL mode and derived import-library filename",
      "files": {
        "dll.c": "dll.c"
      },
      "expected_exit": 0
    },
    {
      "id": "dll-exp-input",
      "arguments": "/Bz /Bk:temp /LD test.c sample.exp",
      "targets": [
        "_driver_switch_17010"
      ],
      "purpose": "Exercise DLL handling of an existing export object without invoking tools",
      "files": {
        "test.c": "../test.c"
      },
      "text_files": {
        "sample.exp": ""
      },
      "expected_exit": 0
    },
    {
      "id": "replace-passes",
      "arguments": "/B1{bin}\\C13232.EXE /B2{bin}\\C23232.EXE /c test.c",
      "targets": [
        "_driver_switch_1713c"
      ],
      "purpose": "Explicitly replace frontend and backend with original executables",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "pass-loader",
      "arguments": "/Bp1{proxy} /c test.c",
      "targets": [
        "_driver_switch_1719c"
      ],
      "purpose": "Run frontend through a forwarding loader and inherited environment",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "child-failure",
      "arguments": "/B1{fail} /c test.c",
      "targets": [
        "_driver_switch_1713c"
      ],
      "purpose": "A replacement phase exits nonzero; CL propagates failure",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 2
    },
    {
      "id": "child-not-found",
      "arguments": "/B1does-not-exist.exe /c test.c",
      "targets": [
        "_driver_switch_1713c",
        "_fatal"
      ],
      "purpose": "Spawn failure and associated diagnostic",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 2
    },
    {
      "id": "ide-feedback",
      "arguments": "/FEEDBACK /c test.c",
      "targets": [
        "_initialize_ide",
        "_ide_message"
      ],
      "purpose": "IDE feedback framing and initialization callbacks",
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "timing",
      "arguments": "/Bt /c test.c",
      "targets": [
        "_start_timer",
        "_report_timer"
      ],
      "purpose": "Phase timing output",
      "files": {
        "test.c": "../test.c"
      },
      "volatile": [
        "wall-clock phase duration"
      ],
      "expected_exit": 0
    },
    {
      "id": "two-sources",
      "arguments": "call.c helper.c /Fetwo.exe",
      "targets": [],
      "purpose": "Multiple compile passes and generated-object insertion",
      "files": {
        "call.c": "call.c",
        "helper.c": "helper.c"
      },
      "expected_exit": 0
    },
    {
      "id": "environment-precedence",
      "arguments": "/c test.c",
      "targets": [],
      "purpose": "CL and _CL_ option ordering, conflicting definitions and /nologo",
      "files": {
        "test.c": "../test.c"
      },
      "environment": {
        "CL": "/O1 /DVALUE=1",
        "_CL_": "/O2 /DVALUE=2 /nologo"
      },
      "expected_exit": 0
    },
    {
      "id": "include-search-list",
      "arguments": "/c /X preprocess.c",
      "targets": [],
      "purpose": "Verify /X suppresses INCLUDE; expect the frontend to report missing settings.h",
      "files": {
        "preprocess.c": "preprocess.c",
        "include dir/settings.h": "settings.h"
      },
      "environment": {
        "INCLUDE": "{cwd}\\missing; ;{cwd}\\include dir"
      },
      "expected_exit": 2
    },
    {
      "id": "include-search-expansion",
      "arguments": "/c preprocess.c",
      "targets": [],
      "purpose": "INCLUDE splitting and multi-directory expansion",
      "files": {
        "preprocess.c": "preprocess.c",
        "include-here/settings.h": "settings.h"
      },
      "environment": {
        "INCLUDE": "{cwd}\\missing; ;{cwd}\\include-here"
      },
      "expected_exit": 0
    },
    {
      "id": "include-unquoted-space",
      "arguments": "/c preprocess.c",
      "targets": [],
      "purpose": "Record original CL failing to quote spaces in INCLUDE entries",
      "files": {
        "preprocess.c": "preprocess.c",
        "include dir/settings.h": "settings.h"
      },
      "environment": {
        "INCLUDE": "{cwd}\\missing; ;{cwd}\\include dir"
      },
      "expected_exit": 2
    },
    {
      "id": "legacy-omf-selector",
      "arguments": "/Bz /Bk:temp /omf test.c",
      "targets": [
        "_write_omf_response"
      ],
      "purpose": "Check whether the internal OMF selector is publicly reachable",
      "files": {
        "test.c": "../test.c"
      },
      "investigation": true,
      "expected_exit": 0
    },
    {
      "id": "mixed-ordering",
      "arguments": "test.c /DVALUE=42 helper.c /c",
      "targets": [
        "_warning"
      ],
      "purpose": "Option between filenames triggers the command-order warning",
      "files": {
        "test.c": "../test.c",
        "helper.c": "helper.c"
      },
      "expected_exit": 0
    },
    {
      "id": "interrupt-idle",
      "arguments": "/?",
      "targets": [
        "_control_handler@4"
      ],
      "purpose": "Invoke CTRL_BREAK handler while help pagination waits for input",
      "mode": "handler-idle",
      "harness": "Direct callback dispatch, not OS console event delivery",
      "expected_events": ["child-running 00000000"],
      "expected_exit": 4
    },
    {
      "id": "interrupt-child",
      "arguments": "/B1{wait} /c test.c",
      "targets": [
        "_control_handler@4"
      ],
      "purpose": "Invoke the registered CTRL_BREAK handler while a controlled replacement pass is running",
      "files": {
        "test.c": "../test.c"
      },
      "mode": "handler-child",
      "harness": "Direct callback dispatch, not OS console event delivery",
      "expected_events": ["child-running 00000001"],
      "expected_exit": 4
    }
  ]
}
