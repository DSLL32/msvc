{
  "description": "Additional public timing cases for the older reconstructed timezone and DST routines; debugger-controlled system time.",
  "cases": [
    {
      "id": "timing-utc",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "UTC0"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "timing-positive-sign",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "ABC+5DST"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "timing-negative-offset",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "NPT-5:45:30"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0
    },
    {
      "id": "timing-dst-start-before",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "EST5EDT"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0,
      "clock_calendar": [
        2026,
        4,
        5,
        1
      ]
    },
    {
      "id": "timing-dst-start-after",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "EST5EDT"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0,
      "clock_calendar": [
        2026,
        4,
        5,
        3
      ]
    },
    {
      "id": "timing-dst-end-before",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "EST5EDT"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0,
      "clock_calendar": [
        2026,
        10,
        25,
        0
      ]
    },
    {
      "id": "timing-dst-end-after",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "EST5EDT"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0,
      "clock_calendar": [
        2026,
        10,
        25,
        2
      ]
    },
    {
      "id": "timing-early-year",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "EST5EDT"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0,
      "clock_calendar": [
        1960,
        7,
        15,
        0
      ]
    },
    {
      "id": "timing-old-april-rule",
      "arguments": "/Bt /c test.c",
      "mode": "clock",
      "environment": {
        "TZ": "EST5EDT"
      },
      "files": {
        "test.c": "../test.c"
      },
      "expected_exit": 0,
      "clock_calendar": [
        1980,
        4,
        27,
        3
      ]
    }
  ]
}
